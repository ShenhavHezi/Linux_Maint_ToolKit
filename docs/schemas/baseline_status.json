{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "linux-maint baseline status --json",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_status_json_contract_version",
    "cfg_dir",
    "summary_file",
    "stale_days",
    "items",
    "summary",
    "attention_items",
    "next_steps",
    "result"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "baseline_status_json_contract_version": { "type": "integer", "minimum": 1 },
    "cfg_dir": { "type": "string" },
    "summary_file": { "type": "string" },
    "stale_days": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "exists",
          "readable",
          "file_count",
          "latest_mtime_epoch",
          "age_seconds",
          "stale",
          "support_file",
          "support_exists",
          "latest_status",
          "latest_reason",
          "changed_hosts"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["ports", "configs", "users", "sudoers"]
          },
          "path": { "type": "string" },
          "exists": { "type": "boolean" },
          "readable": { "type": "boolean" },
          "file_count": { "type": "integer", "minimum": 0 },
          "latest_mtime_epoch": { "type": ["integer", "null"] },
          "age_seconds": { "type": ["integer", "null"], "minimum": 0 },
          "stale": { "type": "boolean" },
          "support_file": { "type": ["string", "null"] },
          "support_exists": { "type": ["boolean", "null"] },
          "latest_status": { "type": ["string", "null"] },
          "latest_reason": { "type": ["string", "null"] },
          "changed_hosts": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "stale_items",
        "fresh_items",
        "drift_items",
        "missing_inputs",
        "changed_hosts_total",
        "oldest_age_seconds"
      ],
      "properties": {
        "stale_items": { "type": "integer", "minimum": 0 },
        "fresh_items": { "type": "integer", "minimum": 0 },
        "drift_items": { "type": "integer", "minimum": 0 },
        "missing_inputs": { "type": "integer", "minimum": 0 },
        "changed_hosts_total": { "type": "integer", "minimum": 0 },
        "oldest_age_seconds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "attention_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "reasons"],
        "properties": {
          "kind": { "type": "string", "enum": ["ports", "configs", "users", "sudoers"] },
          "reasons": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "next_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "result": {
      "type": "string",
      "enum": ["OK", "WARN"]
    }
  },
  "additionalProperties": false
}
