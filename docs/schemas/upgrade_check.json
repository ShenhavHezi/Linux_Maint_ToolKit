{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "linux-maint upgrade --check --json",
  "type": "object",
  "required": [
    "schema_version",
    "upgrade_check_json_contract_version",
    "tarball",
    "current_version",
    "target_version",
    "relation",
    "target_date_utc",
    "release_notes",
    "release_notes_rel",
    "upgrade_guide",
    "checks",
    "highlights",
    "compatibility_notes",
    "warnings"
    ,
    "next_steps",
    "result"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "upgrade_check_json_contract_version": { "type": "integer", "minimum": 1 },
    "tarball": { "type": "string" },
    "current_version": { "type": ["string", "null"] },
    "target_version": { "type": ["string", "null"] },
    "relation": {
      "type": "string",
      "enum": ["upgrade", "downgrade", "same", "unknown"]
    },
    "target_date_utc": { "type": ["string", "null"] },
    "release_notes": { "type": ["string", "null"] },
    "release_notes_rel": { "type": ["string", "null"] },
    "upgrade_guide": { "type": ["string", "null"] },
    "checks": {
      "type": "object",
      "required": ["release_notes_found", "upgrade_guide_found", "sums_supplied", "sig_supplied"],
      "properties": {
        "release_notes_found": { "type": "boolean" },
        "upgrade_guide_found": { "type": "boolean" },
        "sums_supplied": { "type": "boolean" },
        "sig_supplied": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "highlights": {
      "type": "array",
      "items": { "type": "string" }
    },
    "compatibility_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "result": {
      "type": "string",
      "enum": ["OK", "WARN"]
    }
  },
  "additionalProperties": false
}
