{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "linux-maint security-profile --json",
  "type": "object",
  "required": [
    "schema_version",
    "security_profile_contract_version",
    "mode",
    "strict",
    "ok",
    "checks"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "security_profile_contract_version": { "type": "integer", "const": 1 },
    "mode": { "type": "string" },
    "strict": { "type": "boolean" },
    "fips_requested": { "type": "boolean" },
    "fips_enabled": { "type": ["boolean", "null"] },
    "ok": { "type": "boolean" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "ok", "detail"],
        "properties": {
          "check": { "type": "string" },
          "ok": { "type": "boolean" },
          "detail": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
