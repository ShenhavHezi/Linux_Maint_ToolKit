{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "linux-maint status --json",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status_json_contract_version",
    "mode",
    "last_status_file",
    "last_status_state",
    "last_status_errors",
    "last_status",
    "summary_file",
    "totals",
    "problems",
    "runtime_warnings"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string" },
    "status_json_contract_version": { "type": "integer" },
    "mode": { "type": "string" },
    "last_status_file": { "type": ["string", "null"] },
    "last_status_state": { "type": "string", "enum": ["ok", "missing", "unreadable", "malformed"] },
    "last_status_errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "last_status": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "summary_file": { "type": ["string", "null"] },
    "totals": {
      "type": "object",
      "required": ["CRIT", "WARN", "UNKNOWN", "SKIP", "OK"],
      "additionalProperties": false,
      "properties": {
        "CRIT": { "type": "integer" },
        "WARN": { "type": "integer" },
        "UNKNOWN": { "type": "integer" },
        "SKIP": { "type": "integer" },
        "OK": { "type": "integer" }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "monitor", "host"],
        "properties": {
          "status": { "type": "string" },
          "monitor": { "type": "string" },
          "host": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "runtime_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "monitor", "host"],
        "properties": {
          "status": { "type": "string" },
          "monitor": { "type": "string" },
          "host": { "type": "string" },
          "reason": { "type": "string" },
          "target_monitor": { "type": "string" },
          "runtime_ms": { "type": "string" },
          "threshold_ms": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "inventory": {
      "type": "object",
      "required": ["meta_file", "meta_present", "meta_readable", "result", "summary", "coverage", "warnings"],
      "properties": {
        "meta_file": { "type": ["string", "null"] },
        "meta_present": { "type": "boolean" },
        "meta_readable": { "type": "boolean" },
        "result": { "type": "string", "enum": ["OK", "WARN", "ERROR"] },
        "summary": { "type": "object" },
        "coverage": { "type": "object" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "baseline": {
      "type": "object",
      "required": ["baseline_status_json_contract_version", "summary", "attention_items", "next_steps", "result"],
      "properties": {
        "baseline_status_json_contract_version": { "type": "integer", "minimum": 1 },
        "summary": {
          "type": "object",
          "required": ["stale_items", "fresh_items", "drift_items", "missing_inputs", "changed_hosts_total", "oldest_age_seconds"],
          "properties": {
            "stale_items": { "type": "integer", "minimum": 0 },
            "fresh_items": { "type": "integer", "minimum": 0 },
            "drift_items": { "type": "integer", "minimum": 0 },
            "missing_inputs": { "type": "integer", "minimum": 0 },
            "changed_hosts_total": { "type": "integer", "minimum": 0 },
            "oldest_age_seconds": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "attention_items": { "type": "array" },
        "next_steps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "result": { "type": "string", "enum": ["OK", "WARN"] }
      },
      "additionalProperties": true
    },
    "reason_rollup": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason", "count"],
        "properties": {
          "reason": { "type": "string" },
          "count": { "type": "integer" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
