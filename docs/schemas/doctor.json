{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "linux-maint doctor --json",
  "type": "object",
  "required": [
    "schema_version",
    "doctor_json_contract_version",
    "mode",
    "cfg_dir",
    "config",
    "monitor_gates",
    "dependencies",
    "writable_locations",
    "dir_permissions",
    "fix_suggestions",
    "fix_actions",
    "next_actions"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "doctor_json_contract_version": { "type": "integer", "const": 1 },
    "mode": { "type": "string" },
    "strict": { "type": "boolean" },
    "prefix": { "type": "string" },
    "wrapper": { "type": "string" },
    "libexec": { "type": "string" },
    "lib": { "type": "string" },
    "cfg_dir": { "type": "string" },
    "config": {
      "type": "object",
      "required": ["dir_exists", "files", "hosts_configured"],
      "properties": {
        "dir_exists": { "type": "boolean" },
        "hosts_configured": { "type": "integer" },
        "files": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      },
      "additionalProperties": true
    },
    "monitor_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["monitor", "path", "present"],
        "properties": {
          "monitor": { "type": "string" },
          "path": { "type": "string" },
          "present": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cmd", "present"],
        "properties": {
          "cmd": { "type": "string" },
          "present": { "type": "boolean" },
          "hint": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "writable_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "exists", "writable"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean" },
          "writable": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "dir_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "exists", "group_writable", "world_writable", "severity"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean" },
          "group_writable": { "type": "boolean" },
          "world_writable": { "type": "boolean" },
          "severity": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "fix_suggestions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fix_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action", "status"],
        "properties": {
          "id": { "type": "integer" },
          "action": { "type": "string" },
          "target": { "type": "string" },
          "status": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
