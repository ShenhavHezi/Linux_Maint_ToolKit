    docs|faq|troubleshooting|config|monitors|about) printf 'docs help reference explain faq troubleshooting config monitors' ;;
    settings) printf 'settings preferences backend shortcuts compact colors' ;;
    back) printf 'back return previous menu' ;;
    exit) printf 'exit quit close menu' ;;
    *) printf '%s' "$context" ;;
