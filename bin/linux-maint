    ' "${rt_files[@]}" | sort -rn | awk -v color="$RT_COLOR" -v warn_file="$MONITOR_RUNTIME_WARN_FILE" -v yel="$C_YELLOW" -v reset="$C_RESET" '
      BEGIN {
