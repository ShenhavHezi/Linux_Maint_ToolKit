  local logo
  logo="$(cat <<'EOF'
+--------------------------------------------------------------------------------------------------+
|                                                                                                  |
|      _     _                  __  __       _       _                                             |
|     | |   (_)_ __  _   ___  _|  \/  | __ _(_)_ __ | |_                                           |
|     | |   | | '_ \| | | \ \/ / |\/| |/ _` | | '_ \| __|                                          |
|     | |___| | | | | |_| |>  <| |  | | (_| | | | | | |_                                           |
|     |_____|_|_| |_|\__,_/_/\_\_|  |_|\__,_|_|_| |_|\__|                                          |
|                                                                                 .--.             |
|                                                                                |o_o |            |
|                                                                                |:_/ |            |
|                                                                               //   \ \           |
|                                                                              (|     | )          |
|                                                                             /'\_   _/`\          |
|                                                                             \___)=(___/          |
|                                                                                                  |
|                           LinuxMaint • System Automation & Health Framework                      |
|                                                                                                  |
+--------------------------------------------------------------------------------------------------+
EOF
)"
  gum style --border none --foreground "#60a5fa" \
    --padding "0 0" --margin "1 1" --align center \
    "$logo" >&2
}

tui_gum_hint(){
  local msg="${1:-Use arrows + Enter. Esc to go back.}"
  gum style --foreground "#94a3b8" --margin "0 2" "$msg" >&2
}

tui_gum_header(){
  local title="${1:-Linux Maint ToolKit}"
  local subtitle="${2:-Menu}"
  gum style --border rounded --border-foreground "#1d4ed8" --foreground "#e2e8f0" \
    --padding "0 2" --margin "1 1" --align left --width 110 \
    "$(gum style --bold --foreground "#e2e8f0" "$title")" \
    "$(gum style --foreground "#93c5fd" "$subtitle")" >&2
}


tui_gum_card(){
  local title="$1" color="$2" body="$3" width="${4:-110}"
  tui_gum_card_render "$title" "$color" "$body" "$width" >&2
}

tui_gum_card_render(){
  local title="$1" color="$2" body="$3" width="${4:-110}"
  local title_line content
  title_line="$(gum style --bold --foreground "$color" "$title")"
  content="$(printf '%s\n%s' "$title_line" "$body")"
  gum style --border rounded --border-foreground "$color" --padding "1 2" --margin "0 1" \
    --foreground "#e5e7eb" --width "$width" "$content"
}

tui_render_columns(){
  local left="${1:-}" right="${2:-}" gutter="${3:-  }"
  LEFT_BLOCK="$left" RIGHT_BLOCK="$right" GUTTER_BLOCK="$gutter" python3 - <<'PY'
import os
import re

ansi_re = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")

def visible_len(s):
    return len(ansi_re.sub("", s))

left = os.environ.get("LEFT_BLOCK", "").splitlines()
right = os.environ.get("RIGHT_BLOCK", "").splitlines()
gutter = os.environ.get("GUTTER_BLOCK", "  ")
left_width = 0
for line in left:
    left_width = max(left_width, visible_len(line))

rows = max(len(left), len(right))
for idx in range(rows):
    l = left[idx] if idx < len(left) else ""
    r = right[idx] if idx < len(right) else ""
    pad = max(0, left_width - visible_len(l))
    print(f"{l}{' ' * pad}{gutter}{r}".rstrip())
PY
}

tui_gum_context_panel(){
  local status_json="${1:-}" width="${2:-110}"
  tui_gum_context_panel_render "$status_json" "$width" >&2
}

tui_gum_context_panel_render(){
  local status_json="${1:-}" width="${2:-110}"
  local snapshot mode cfg_dir log_dir state_dir overall ok warn crit unk skip age shortcuts preview config_dir_exists inventory_ready summary_ready log_ready history_ready
  snapshot="$(tui_context_snapshot "$status_json")"
  while IFS='=' read -r k v; do
    case "$k" in
      mode) mode="$v" ;;
      cfg_dir) cfg_dir="$v" ;;
      log_dir) log_dir="$v" ;;
      state_dir) state_dir="$v" ;;
      overall) overall="$v" ;;
      ok) ok="$v" ;;
      warn) warn="$v" ;;
      crit) crit="$v" ;;
      unknown) unk="$v" ;;
      skip) skip="$v" ;;
      last_age) age="$v" ;;
      shortcuts) shortcuts="$v" ;;
      preview) preview="$v" ;;
      config_dir_exists) config_dir_exists="$v" ;;
      inventory_ready) inventory_ready="$v" ;;
      summary_ready) summary_ready="$v" ;;
      log_ready) log_ready="$v" ;;
      history_ready) history_ready="$v" ;;
    esac
  done <<< "$snapshot"

  local shortcuts_label="off" preview_label="off"
  tui_bool_enabled "${shortcuts:-0}" && shortcuts_label="on"
  tui_bool_enabled "${preview:-0}" && preview_label="on"
  local config_label="missing" inventory_label="missing" summary_label="no" history_label="no" logs_label="no"
  [[ "${config_dir_exists:-0}" == "1" ]] && config_label="ready"
  [[ "${inventory_ready:-0}" == "1" ]] && inventory_label="ready"
  [[ "${summary_ready:-0}" == "1" ]] && summary_label="yes"
  [[ "${history_ready:-0}" == "1" ]] && history_label="yes"
  [[ "${log_ready:-0}" == "1" ]] && logs_label="yes"

  local overall_color="#93c5fd"
  case "${overall:-UNKNOWN}" in
    CRIT) overall_color="#ef4444" ;;
    WARN) overall_color="#f59e0b" ;;
    OK) overall_color="#22c55e" ;;
  esac

  local line1 line2 line3
  line1="mode=${mode:-unknown}  overall=$(gum style --bold --foreground "$overall_color" "${overall:-UNKNOWN}")  last_run=$(tui_format_age_seconds "${age:--1}")  shortcuts=$shortcuts_label  preview=$preview_label"
  line2="cfg=${cfg_dir:-?}  log=${log_dir:-?}  state=${state_dir:-?}"
  line3="config=$config_label  inventory=$inventory_label  summary=$summary_label  history=$history_label  logs=$logs_label"
  tui_gum_card_render "Active context" "#334155" "$(printf '%s\n%s\n%s' "$line1" "$line2" "$line3")" "$width"
}

resolve_menu_shortcut_tag(){
  local key="$1"
  shift || true
  key="${key,,}"
  [[ -n "$key" ]] || return 1
  local match="" tag first
  for tag in "$@"; do
    first="${tag:0:1}"
    first="${first,,}"
    if [[ "$first" == "$key" ]]; then
      if [[ -n "$match" ]]; then
        return 1
      fi
      match="$tag"
    fi
  done
  [[ -n "$match" ]] || return 1
  printf '%s' "$match"
}

tui_gum_read_visible_menu_choice(){
  local context="$1"
  shift || true
  local -a tags=("$@")
  [[ -t 0 ]] || return 1
  local key next third choice idx
  IFS= read -rsn1 key < /dev/tty || return 130
  case "$key" in
    $'\n'|'')
      return 2
      ;;
    $'\e')
      IFS= read -rsn1 -t 0.03 next < /dev/tty || return 130
      if [[ "$next" == "[" ]]; then
        IFS= read -rsn1 -t 0.03 third < /dev/tty || return 2
        case "$third" in
          A|B|C|D) return 2 ;;
          *) return 130 ;;
        esac
      fi
      return 130
      ;;
    [1-9])
      idx=$((10#$key - 1))
      if (( idx >= 0 && idx < ${#tags[@]} )); then
        printf '%s' "${tags[$idx]}"
        return 0
      fi
      return 1
      ;;
    '?')
      printf '__help__'
      return 0
      ;;
    '/')
      printf '__search__'
      return 0
      ;;
    '.')
      printf '__preview__'
      return 0
      ;;
    *)
      if [[ "${LM_TUI_SHORTCUTS:-1}" =~ ^(1|true|TRUE|yes|YES|on|ON)$ ]]; then
        local mapped
        mapped="$(map_menu_shortcut "$key" "$context")"
        if [[ "$mapped" != "$key" ]]; then
          local t
          for t in "${tags[@]}"; do
            if [[ "$t" == "$mapped" ]]; then
              printf '%s' "$mapped"
              return 0
            fi
          done
        fi
        choice="$(resolve_menu_shortcut_tag "$key" "${tags[@]}" || true)"
        if [[ -n "$choice" ]]; then
          printf '%s' "$choice"
          return 0
        fi
      fi
      return 1
      ;;
  esac
}


tui_section_uses_empty_state(){
  local context="${1:-main}" snapshot="${2:-}"
  [[ -n "$snapshot" ]] || snapshot="$(tui_bootstrap_state_snapshot)"
  local config_dir_exists inventory_ready summary_ready log_ready history_ready
  config_dir_exists="$(tui_snapshot_value "$snapshot" config_dir_exists)"
  inventory_ready="$(tui_snapshot_value "$snapshot" inventory_ready)"
  summary_ready="$(tui_snapshot_value "$snapshot" summary_ready)"
  log_ready="$(tui_snapshot_value "$snapshot" log_ready)"
  history_ready="$(tui_snapshot_value "$snapshot" history_ready)"
  case "$context" in
    quickstart)
      return 0
      ;;
    overview|main)
      [[ "$summary_ready" == "1" ]] && return 1
      return 0
      ;;
    run)
      [[ "$config_dir_exists" == "1" && "$inventory_ready" == "1" ]] && return 1
      return 0
      ;;
    investigate)
      if [[ "$summary_ready" == "1" && ( "$history_ready" == "1" || "$log_ready" == "1" ) ]]; then
        return 1
      fi
      return 0
      ;;
    triage)
      if [[ "$summary_ready" == "1" || "$log_ready" == "1" || "$history_ready" == "1" || "$inventory_ready" == "1" ]]; then
        return 1
      fi
      return 0
      ;;
    repair)
      if [[ "$summary_ready" == "1" || "$inventory_ready" == "1" ]]; then
        return 1
      fi
      return 0
      ;;
    export)
      if [[ "$summary_ready" == "1" || "$log_ready" == "1" || "$history_ready" == "1" ]]; then
        return 1
      fi
      return 0
      ;;
    share)
      return 1
      ;;
    docs)
      [[ "$config_dir_exists" == "1" ]] && return 1
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

tui_section_empty_state_body(){
  local context="${1:-overview}" snapshot="${2:-}"
  [[ -n "$snapshot" ]] || snapshot="$(tui_bootstrap_state_snapshot)"
  local cfg_dir serverlist hosts_dir summary_json summary_ready log_ready history_ready
  cfg_dir="$(tui_snapshot_value "$snapshot" cfg_dir)"
  serverlist="$(tui_snapshot_value "$snapshot" serverlist)"
  hosts_dir="$(tui_snapshot_value "$snapshot" hosts_dir)"
  summary_json="$(tui_snapshot_value "$snapshot" summary_json)"
  summary_ready="$(tui_snapshot_value "$snapshot" summary_ready)"
  log_ready="$(tui_snapshot_value "$snapshot" log_ready)"
  history_ready="$(tui_snapshot_value "$snapshot" history_ready)"
  case "$context" in
    quickstart)
      printf '%s\n' \
        "Recommended first action: first_setup" \
        "- Use the bootstrap wizard to create config, validate readiness, and preview the first run" \
        "- Current incident is best after you already have a summary or active failure" \
        "- Escalation is most useful once report, JSON, or bundle artifacts exist"
      ;;
    overview|main)
      printf '%s\n' \
        "Recommended first action: first_setup" \
        "- No current summary yet at $summary_json" \
        "- Start in Quickstart, then run check and run --plan before the first live run" \
        "- Overview becomes the fast answer screen after the first successful execution"
      ;;
    run)
      printf '%s\n' \
        "Recommended first action: first_setup" \
        "- Before a live run, create or review config in $cfg_dir" \
        "- Add targets in $serverlist or under $hosts_dir" \
        "- Use plan once the inventory is ready"
      ;;
    investigate)
      printf '%s\n' \
        "Recommended first action: first_setup" \
        "- Investigate needs either a summary, a log, or history artifacts" \
        "- summary=$( [[ "$summary_ready" == "1" ]] && printf yes || printf no )  logs=$( [[ "$log_ready" == "1" ]] && printf yes || printf no )  history=$( [[ "$history_ready" == "1" ]] && printf yes || printf no )" \
        "- Run check and a safe plan first, then come back for drilldown"
      ;;
    triage)
      printf '%s\n' \
        "Recommended first action: first_setup" \
        "- Triage works best once you have a summary, a wrapper log, or at least a configured inventory" \
        "- summary=$( [[ "$summary_ready" == "1" ]] && printf yes || printf no )  logs=$( [[ "$log_ready" == "1" ]] && printf yes || printf no )  history=$( [[ "$history_ready" == "1" ]] && printf yes || printf no )" \
        "- Start with check and a safe plan, then come back for drilldown or incident response"
      ;;
    repair)
      printf '%s\n' \
        "Recommended first action: first_setup" \
        "- Repair can validate config even before the first live run" \
        "- Start with check and doctor once the starter config is in place" \
        "- Incident mode is strongest after you have an actual failure snapshot"
      ;;
    export)
      printf '%s\n' \
        "Recommended first action: first_setup" \
        "- Export needs current artifacts before it becomes useful" \
        "- Generate a summary or log first with check/run and then return for reports or bundles" \
        "- After the first run you can export JSON, metrics, or a support bundle"
      ;;
    share)
      printf '%s\n' \
        "Recommended first action: quickref" \
        "- Share combines handoff artifacts with reference docs in one place" \
        "- Reports and JSON become useful after the first summary or wrapper log" \
        "- Quick reference and troubleshooting are still available before the first run"
      ;;
    docs)
      printf '%s\n' \
        "Recommended first action: first_setup" \
        "- Open quick reference and config docs before editing $cfg_dir" \
        "- Use docs to understand monitor inputs and expected skip behavior" \
        "- Then return to Quickstart for the guided bootstrap"
      ;;
    *)
      printf '%s\n' \
        "Recommended first action: first_setup" \
        "- Start with the bootstrap wizard"
      ;;
  esac
}

tui_fallback_menu_prompt_body(){
  local prompt="$1" context="${2:-main}" status_json snapshot mode overall age cfg_dir log_dir summary_ready inventory_ready history_ready recommended focus preview_line
  status_json="$(tui_status_snapshot_json)"
  snapshot="$(tui_context_snapshot "$status_json")"
  mode="$(tui_snapshot_value "$snapshot" mode)"
  overall="$(tui_snapshot_value "$snapshot" overall)"
  age="$(tui_snapshot_value "$snapshot" last_age)"
  cfg_dir="$(tui_snapshot_value "$snapshot" cfg_dir)"
  log_dir="$(tui_snapshot_value "$snapshot" log_dir)"
  summary_ready="$(tui_snapshot_value "$snapshot" summary_ready)"
  inventory_ready="$(tui_snapshot_value "$snapshot" inventory_ready)"
  history_ready="$(tui_snapshot_value "$snapshot" history_ready)"
  recommended="$(tui_section_recommended_action "$context" "$status_json")"
  focus="$(tui_section_preview_body "$context" "$status_json" | head -n 2 | tail -n 1)"
  preview_line="$(tui_menu_action_preview_body "$context" "$recommended" "" | sed -n '1p')"
  printf '%s\n\n' "$prompt"
  printf 'Use arrows to choose. Enter opens. Esc goes back.\n\n'
  printf 'Section:\n'
  printf '  %s\n' "$(tui_fallback_section_summary "$context")"
  printf '\nState:\n'
  printf '  mode=%s  overall=%s  last_run=%s\n' "${mode:-unknown}" "${overall:-UNKNOWN}" "$(tui_format_age_seconds "${age:--1}")"
  printf '  inventory=%s  summary=%s  history=%s\n' \
    "$( [[ "${inventory_ready:-0}" == "1" ]] && printf ready || printf missing )" \
    "$( [[ "${summary_ready:-0}" == "1" ]] && printf yes || printf no )" \
    "$( [[ "${history_ready:-0}" == "1" ]] && printf yes || printf no )"
  printf '  cfg=%s\n' "${cfg_dir:-?}"
  printf '  log=%s\n' "${log_dir:-?}"
  printf '\nRecommended now:\n'
  printf '  start=%s\n' "${recommended:-overview}"
  printf '  %s\n' "${focus:-- Start with the landing dashboard}"
  printf '\nHighlighted action:\n'
  printf '  %s\n' "${preview_line:-Open the recommended action for more detail.}"
}

tui_fallback_section_summary(){
  local context="${1:-main}"
  case "$context" in
    main) printf '%s' "Pick the workflow lane that matches what you need right now." ;;
    quickstart) printf '%s' "Setup, guided rescue, and escalation for new or unstable environments." ;;
    overview) printf '%s' "Fast fleet answer: dashboard, status, problems, and short report." ;;
    run) printf '%s' "Preview scope first, then execute checks when the plan looks right." ;;
    triage) printf '%s' "Narrow the failure, inspect evidence, and move into safe recovery." ;;
    share) printf '%s' "Prepare human handoff, machine export, bundle, or operator reference." ;;
    investigate) printf '%s' "Inspect status slices, logs, history, and change context." ;;
    repair) printf '%s' "Validate readiness and run guided recovery actions." ;;
    export) printf '%s' "Produce reports, machine output, metrics, and support bundles." ;;
    docs) printf '%s' "Open quick reference, troubleshooting, explanations, and settings." ;;
    *) printf '%s' "Choose the next action for the current operator task." ;;
  esac
}

tui_gum_status_overview(){
  local status_json="${1:-}" width="${2:-110}"
  tui_gum_status_overview_render "$status_json" "$width" >&2
}

tui_gum_status_overview_render(){
  local status_json="${1:-}" width="${2:-110}" overall ok warn crit unk skip summary_file
  [[ -n "$status_json" ]] || status_json="$(tui_status_snapshot_json)"
  if ! tui_has_summary_snapshot; then
    local empty_body
    empty_body="$(printf '%s\n%s\n%s' \
      "$(gum style --bold --foreground "#14b8a6" "Overall: .. Not started")" \
      "No current summary yet. Start with Quickstart -> first setup." \
      "Then run check and run --plan before the first live execution.")"
    tui_gum_card_render "Fleet status" "#14b8a6" "$empty_body" "$width"
    return 0
  fi
  overall="UNKNOWN"
  ok=0; warn=0; crit=0; unk=0; skip=0; summary_file=""
  if [[ -n "$status_json" ]]; then
    while IFS='=' read -r k v; do
      case "$k" in
        overall) overall="$v" ;;
        ok) ok="$v" ;;
        warn) warn="$v" ;;
        crit) crit="$v" ;;
        unknown) unk="$v" ;;
        skip) skip="$v" ;;
        summary) summary_file="$v" ;;
      esac
    done < <(STATUS_JSON="$status_json" python3 - <<'PY'
import json
import os
import sys

raw = os.environ.get("STATUS_JSON", "")
if not raw:
    sys.exit(0)
try:
    data = json.loads(raw)
except Exception:
    sys.exit(0)
totals = data.get("totals", {}) or {}
if not totals and (data.get("rows") or []):
    totals = {"OK": 0, "WARN": 0, "CRIT": 0, "UNKNOWN": 0, "SKIP": 0}
    for row in data.get("rows") or []:
        st = str((row or {}).get("status") or "")
        if st in totals:
            totals[st] += 1
def g(k):
    try:
        return int(totals.get(k, 0) or 0)
    except Exception:
        return 0

ok = g("OK")
warn = g("WARN")
crit = g("CRIT")
unk = g("UNKNOWN")
skip = g("SKIP")

if crit > 0:
    overall = "CRIT"
elif warn > 0:
    overall = "WARN"
elif unk > 0:
    overall = "UNKNOWN"
elif ok > 0:
    overall = "OK"
else:
    overall = "UNKNOWN"

summary = data.get("summary_file") or data.get("meta", {}).get("summary_file") or ""

print(f"overall={overall}")
print(f"ok={ok}")
print(f"warn={warn}")
print(f"crit={crit}")
print(f"unknown={unk}")
print(f"skip={skip}")
print(f"summary={summary}")
PY
    )
  fi

  local color="#60a5fa"
  case "$overall" in
    CRIT) color="#ef4444" ;;
    WARN) color="#f59e0b" ;;
    OK) color="#22c55e" ;;
    UNKNOWN) color="#93c5fd" ;;
  esac

  local log_file log_lines
  log_file="$(tui_latest_log_path)"
  if [[ -f "$log_file" ]]; then
    log_lines="$(tail -n 3 "$log_file" 2>/dev/null | sed 's/^/  /')"
  else
    log_lines="  (no log yet: $log_file)"
  fi

  local overall_line totals_line body sym
  sym="$(severity_symbol "$overall")"
  overall_line="$(gum style --bold --foreground "$color" "Overall: $sym $overall")"
  totals_line="$(gum style --foreground "#e5e7eb" "OK:$ok  WARN:$warn  CRIT:$crit  UNKNOWN:$unk  SKIP:$skip")"
  body="$(gum join --vertical "$overall_line" "$totals_line")"

  tui_gum_card_render "Fleet status" "$color" "$body" "$width"
}

tui_top_reason_lines(){
  local status_json="$1" limit="${2:-3}"
  STATUS_JSON="$status_json" LIMIT_LOCAL="$limit" python3 - <<'PY'
import json
import os
from collections import Counter
raw = os.environ.get("STATUS_JSON", "")
limit = int(os.environ.get("LIMIT_LOCAL", "3") or 3)
try:
    data = json.loads(raw) if raw else {}
except Exception:
    data = {}
rows = data.get("reason_rollup") or []
printed = 0
if rows:
    for row in rows[:limit]:
        reason = str((row or {}).get("reason") or "-").replace("\n", " ")
        count = str((row or {}).get("count") or "0")
        print(f"- {reason} ({count})")
        printed += 1
else:
    counter = Counter()
    for row in data.get("rows") or []:
        status = str((row or {}).get("status") or "")
        reason = str((row or {}).get("reason") or "").strip()
        if status not in ("OK", "SKIP") and reason:
            counter[reason] += 1
    for reason, count in counter.most_common(limit):
        print(f"- {reason} ({count})")
        printed += 1
if printed == 0:
    print("- no non-OK reasons yet")
PY
}

tui_problem_lines(){
  local status_json="$1" limit="${2:-4}"
  STATUS_JSON="$status_json" LIMIT_LOCAL="$limit" python3 - <<'PY'
import json
import os
raw = os.environ.get("STATUS_JSON", "")
limit = int(os.environ.get("LIMIT_LOCAL", "4") or 4)
try:
    data = json.loads(raw) if raw else {}
except Exception:
    data = {}
rows = data.get("problems") or []
if not rows:
    rows = [r for r in (data.get("rows") or []) if str((r or {}).get("status") or "") in ("WARN", "CRIT", "UNKNOWN")]
printed = 0
for row in rows[:limit]:
    status = str((row or {}).get("status") or "?")
    monitor = str((row or {}).get("monitor") or "-")
    host = str((row or {}).get("host") or "-")
    reason = str((row or {}).get("reason") or "-").replace("\n", " ")
    print(f"- {status} {monitor} host={host} reason={reason}")
    printed += 1
if printed == 0:
    print("- no current problems")
PY
}

tui_runtime_lines(){
  local runtimes_json="${1:-}" limit="${2:-3}"
  local log_file
  log_file="$(tui_latest_log_path)"
  if [[ -f "$log_file" ]]; then
    awk -v limit="$limit" '
      /Top runtimes \(ms\)/ {capture=1; next}
      capture && /^\[/ {
        line=$0
        sub(/^\[[^]]+\][[:space:]]+/, "", line)
        if (line ~ /^[A-Za-z0-9_]+ ms=[0-9]+$/) {
          split(line, parts, / ms=/)
          printf("- %s (%s ms)\n", parts[1], parts[2])
          count++
          if (count >= limit) exit
          next
        }
        if (count > 0) exit
      }
      END {
        if (count == 0) print "- no runtime data yet"
      }
    ' "$log_file"
  else
    echo "- no runtime data yet"
  fi
}

tui_incident_recommendation_key(){
  local reason="${1:-}" monitor="${2:-}"
  case "$reason" in
    ssh_unreachable|dns_*|ping_*|tcp_*|http_*|network_*) printf 'connectivity' ;;
    config_missing|source_failed|invalid_types|baseline_missing|summary_write_failed|summary_checksum_failed|permission_denied) printf 'config' ;;
    service_failed|failed_units|service_inactive) printf 'service' ;;
    security_updates_pending|updates_pending) printf 'patching' ;;
    runtime_exceeded|timeout) printf 'runtime' ;;
    *)
      case "$monitor" in
        network*|cert*|ntp_*) printf 'connectivity' ;;
        service*) printf 'service' ;;
        config_*|ports_baseline*|user_monitor|backup_check) printf 'config' ;;
        patch*) printf 'patching' ;;
        *) printf 'general' ;;
      esac
      ;;
  esac
}

tui_next_moves_lines(){
  local overall="${1:-UNKNOWN}" reason="${2:-}" monitor="${3:-}"
  local key
  key="$(tui_incident_recommendation_key "$reason" "$monitor")"
  case "$key" in
    connectivity)
      printf '%s\n' \
        "- Open Triage for guided connectivity triage" \
        "- Use drilldown or logs to inspect the failing host" \
        "- Re-run focused network checks after access is restored"
      ;;
    config)
      printf '%s\n' \
        "- Open Triage for config/init and doctor checks" \
        "- Open Share for quick reference and troubleshooting" \
        "- Re-run check before a full fleet run"
      ;;
    service)
      printf '%s\n' \
        "- Open Triage for service-oriented incident steps" \
        "- Use drilldown and logs to inspect status and wrapper output" \
        "- Re-run focused service checks after remediation"
      ;;
    patching)
      printf '%s\n' \
        "- Open Triage to confirm the affected hosts and reasons" \
        "- Apply your update workflow outside the menu" \
        "- Re-run status or report after patching"
      ;;
    runtime)
      printf '%s\n' \
        "- Open Share to inspect recent runtimes" \
        "- Open Triage to run doctor and readiness checks" \
        "- Tune thresholds or timeouts before the next run"
      ;;
    *)
      if [[ "$overall" == "CRIT" || "$overall" == "WARN" ]]; then
        printf '%s\n' \
          "- Open Triage for doctor, drilldown, and guided incident response" \
          "- Create a bundle if you need to escalate"
      else
        printf '%s\n' \
          "- Review trend and runtimes in Share" \
          "- Open Share for monitor and reason references" \
          "- Use Run to plan or execute the next check"
      fi
      ;;
  esac
}

tui_status_focus_snapshot(){
  local status_json="${1:-}"
  STATUS_JSON="$status_json" python3 - <<'PY'
import json
import os

raw = os.environ.get("STATUS_JSON", "")
overall = "UNKNOWN"
top_reason = "-"
top_monitor = "-"
top_host = "-"
try:
    data = json.loads(raw) if raw else {}
except Exception:
    data = {}
overall = str(
    (data.get("last_status") or {}).get("overall")
    or (data.get("meta") or {}).get("overall")
    or "UNKNOWN"
)
rows = data.get("reason_rollup") or []
if rows:
    top_reason = str((rows[0] or {}).get("reason") or "-")
else:
    for row in data.get("rows") or []:
        status = str((row or {}).get("status") or "")
        reason = str((row or {}).get("reason") or "")
        if status in ("WARN", "CRIT", "UNKNOWN") and reason:
            top_reason = reason
            break
problems = data.get("problems") or []
if problems:
    top_monitor = str((problems[0] or {}).get("monitor") or "-")
    top_host = str((problems[0] or {}).get("host") or "-")
else:
    for row in data.get("rows") or []:
        status = str((row or {}).get("status") or "")
        if status in ("WARN", "CRIT", "UNKNOWN"):
            top_monitor = str((row or {}).get("monitor") or "-")
            top_host = str((row or {}).get("host") or "-")
            break
print(f"overall={overall}")
print(f"top_reason={top_reason}")
print(f"top_monitor={top_monitor}")
print(f"top_host={top_host}")
PY
}

tui_section_recommended_action(){
  local context="${1:-main}" status_json="${2:-}"
  local focus overall top_reason top_monitor boot_snapshot config_dir_exists inventory_ready summary_ready log_ready history_ready
  focus="$(tui_status_focus_snapshot "$status_json")"
  overall="$(printf '%s\n' "$focus" | awk -F= '/^overall=/{print $2; exit}')"
  top_reason="$(printf '%s\n' "$focus" | awk -F= '/^top_reason=/{print $2; exit}')"
  top_monitor="$(printf '%s\n' "$focus" | awk -F= '/^top_monitor=/{print $2; exit}')"
  boot_snapshot="$(tui_bootstrap_state_snapshot)"
  config_dir_exists="$(tui_snapshot_value "$boot_snapshot" config_dir_exists)"
  inventory_ready="$(tui_snapshot_value "$boot_snapshot" inventory_ready)"
  summary_ready="$(tui_snapshot_value "$boot_snapshot" summary_ready)"
  log_ready="$(tui_snapshot_value "$boot_snapshot" log_ready)"
  history_ready="$(tui_snapshot_value "$boot_snapshot" history_ready)"
  if [[ "$context" != "quickstart" ]]; then
    case "$context" in
      overview)
        if [[ "$config_dir_exists" != "1" || "$inventory_ready" != "1" || "$summary_ready" != "1" ]]; then
          printf 'first_setup'
          return 0
        fi
        ;;
      run)
        if [[ "$config_dir_exists" != "1" || "$inventory_ready" != "1" ]]; then
          printf 'first_setup'
          return 0
        fi
        ;;
      repair)
        if [[ "$config_dir_exists" != "1" || "$inventory_ready" != "1" ]]; then
          printf 'first_setup'
          return 0
        fi
        if [[ "$summary_ready" != "1" ]]; then
          printf 'check'
          return 0
        fi
        ;;
      docs)
        if [[ "$config_dir_exists" != "1" ]]; then
          printf 'first_setup'
          return 0
        fi
        ;;
    investigate)
      if [[ "$summary_ready" != "1" || ( "$history_ready" != "1" && "$log_ready" != "1" ) ]]; then
        printf 'first_setup'
        return 0
      fi
      ;;
    triage)
      if [[ "$config_dir_exists" != "1" || "$inventory_ready" != "1" ]]; then
        printf 'first_setup'
        return 0
      fi
      if [[ "$summary_ready" != "1" && "$log_ready" != "1" && "$history_ready" != "1" ]]; then
        printf 'check'
        return 0
      fi
      ;;
    export)
      if [[ "$summary_ready" != "1" && "$log_ready" != "1" && "$history_ready" != "1" ]]; then
        printf 'first_setup'
        return 0
      fi
      ;;
    share)
      if [[ "$summary_ready" != "1" && "$log_ready" != "1" && "$history_ready" != "1" ]]; then
        printf 'quickref'
        return 0
      fi
      ;;
  esac
  fi
  case "$context" in
    quickstart) printf 'first_setup' ;;
    overview)
      if [[ "$overall" == "CRIT" || "$overall" == "WARN" || "$overall" == "UNKNOWN" ]]; then
        printf 'problems'
      else
        printf 'dashboard'
      fi
      ;;
    run) printf 'plan' ;;
    investigate)
      if [[ -n "$top_reason" && "$top_reason" != "-" ]]; then
        printf 'drilldown'
      else
        printf 'history'
      fi
      ;;
    triage)
      if [[ "$overall" == "CRIT" || "$overall" == "WARN" || "$overall" == "UNKNOWN" ]]; then
        printf 'incident'
      elif [[ -n "$top_reason" && "$top_reason" != "-" ]]; then
        printf 'drilldown'
      else
        printf 'check'
      fi
      ;;
    repair)
      if [[ "$overall" == "CRIT" || "$overall" == "WARN" || "$overall" == "UNKNOWN" ]]; then
        printf 'incident'
      else
        printf 'check'
      fi
      ;;
    export)
      if [[ "$overall" == "CRIT" || "$overall" == "WARN" || "$overall" == "UNKNOWN" ]]; then
        printf 'report'
      else
        printf 'export_json'
      fi
      ;;
    share)
      if [[ "$overall" == "CRIT" || "$overall" == "WARN" || "$overall" == "UNKNOWN" ]]; then
        printf 'report'
      else
        printf 'quickref'
      fi
      ;;
    docs) printf 'quickref' ;;
    *) printf 'overview' ;;
  esac
}

tui_section_preview_body(){
  local context="${1:-main}" status_json="${2:-}"
  local focus overall top_reason top_monitor top_host next_action boot_snapshot
  boot_snapshot="$(tui_bootstrap_state_snapshot)"
  if tui_section_uses_empty_state "$context" "$boot_snapshot"; then
    tui_section_empty_state_body "$context" "$boot_snapshot"
    return 0
  fi
  focus="$(tui_status_focus_snapshot "$status_json")"
  overall="$(printf '%s\n' "$focus" | awk -F= '/^overall=/{print $2; exit}')"
  top_reason="$(printf '%s\n' "$focus" | awk -F= '/^top_reason=/{print $2; exit}')"
  top_monitor="$(printf '%s\n' "$focus" | awk -F= '/^top_monitor=/{print $2; exit}')"
  top_host="$(printf '%s\n' "$focus" | awk -F= '/^top_host=/{print $2; exit}')"
  next_action="$(tui_section_recommended_action "$context" "$status_json")"
  case "$context" in
    quickstart)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "- First setup for init, check, and safe plan review" \
        "- Current incident for guided triage and repair" \
        "- Escalation for report, JSON export, and support bundle" \
        "- Direct shortcuts: inventory edit, hosts.d overview, and setup docs"
      ;;
    overview)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "- Dashboard for the live operations view" \
        "- Problems for the latest non-OK rows" \
        "- Report when you need a short operator summary"
      ;;
    run)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "- Plan first when config or scope changed" \
        "- Wizard for group/host targeting and safe previews" \
        "- Run now when you already know the exact scope"
      ;;
    investigate)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "Top reason: ${top_reason:--}" \
        "Top problem: ${top_monitor:--} host=${top_host:--}" \
        "- Follow with logs or diff once you narrow the slice"
      ;;
    triage)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "Current triage: $(tui_incident_recommendation_summary "$top_reason" "$top_monitor" "$top_host")" \
        "- Start with drilldown when you need to narrow the failure" \
        "- Use doctor or focused_run once you know where to intervene"
      ;;
    repair)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "Current triage: $(tui_incident_recommendation_summary "$top_reason" "$top_monitor" "$top_host")" \
        "- Doctor validates deeper dependencies and fixes" \
        "- Check confirms readiness before the next full run"
      ;;
    export)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "- Report for people, export JSON for systems" \
        "- Metrics and runtimes for dashboards and tuning" \
        "- Pack logs when you need a support bundle"
      ;;
    share)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "- Report and export JSON for handoff" \
        "- Pack logs when you need an escalation bundle" \
        "- Quick reference and troubleshooting stay close to the artifacts"
      ;;
    docs)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "- Quick reference for the common operator path" \
        "- Troubleshooting for reason tokens and failures" \
        "- Config shows the active sources and values"
      ;;
    *)
      printf '%s\n' \
        "Recommended first action: overview" \
        "- Start with the landing dashboard"
      ;;
  esac
}

tui_gum_section_focus_card(){
  local context="${1:-main}" status_json="${2:-}" width="${3:-52}"
  local color="#15803d"
  case "$context" in
    quickstart) color="#0f766e" ;;
    overview) color="#2563eb" ;;
    investigate|repair|triage) color="#b45309" ;;
    export|share) color="#2563eb" ;;
    docs) color="#0f766e" ;;
    run) color="#15803d" ;;
  esac
  tui_gum_card_render "Recommended start" "$color" "$(tui_section_preview_body "$context" "$status_json")" "$width"
}

tui_bootstrap_baseline_wizard(){
  local choice
  TUI_SHORTCUT_CONTEXT="quickstart"
  choice="$(tui_menu_prompt_safe "Starter baselines" \
    all "Create local baselines for ports, configs, users, and sudoers" \
    ports "Capture local ports baseline" \
    configs "Capture local config drift baseline" \
    users "Capture local users baseline" \
    sudoers "Capture local sudoers baseline" \
    skip "Skip baseline capture for now")"
  choice="$(normalize_menu_choice "$choice")"
  case "$choice" in
    all)
      tui_run_cmd "linux-maint baseline ports --update --local-only" "$0" baseline ports --update --local-only
      tui_run_cmd "linux-maint baseline configs --update --local-only" "$0" baseline configs --update --local-only
      tui_run_cmd "linux-maint baseline users --update --local-only" "$0" baseline users --update --local-only
      tui_run_cmd "linux-maint baseline sudoers --update --local-only" "$0" baseline sudoers --update --local-only
      ;;
    ports|configs|users|sudoers)
      tui_run_cmd "linux-maint baseline $choice --update --local-only" "$0" baseline "$choice" --update --local-only
      ;;
  esac
}

tui_quickstart_first_setup(){
  local boot_snapshot cfg_dir serverlist hosts_dir config_dir_exists inventory_ready summary_ready history_ready optional_skips_present
  local init_choice choice optional_banner quickref
  boot_snapshot="$(tui_bootstrap_state_snapshot)"
  cfg_dir="$(tui_snapshot_value "$boot_snapshot" cfg_dir)"
  serverlist="$(tui_snapshot_value "$boot_snapshot" serverlist)"
  hosts_dir="$(tui_snapshot_value "$boot_snapshot" hosts_dir)"
  config_dir_exists="$(tui_snapshot_value "$boot_snapshot" config_dir_exists)"
  inventory_ready="$(tui_snapshot_value "$boot_snapshot" inventory_ready)"
  summary_ready="$(tui_snapshot_value "$boot_snapshot" summary_ready)"
  history_ready="$(tui_snapshot_value "$boot_snapshot" history_ready)"
  optional_skips_present="$(tui_snapshot_value "$boot_snapshot" optional_skips_present)"

  tui_msgbox "$(printf 'First setup assistant\n\nMode: %s\nConfig dir: %s\nInventory ready: %s\nCurrent summary: %s\nHistory: %s\n\nWhat is missing now:\n%s' \
    "$MODE" \
    "$cfg_dir" \
    "$( [[ "$inventory_ready" == "1" ]] && printf yes || printf no )" \
    "$( [[ "$summary_ready" == "1" ]] && printf yes || printf no )" \
    "$( [[ "$history_ready" == "1" ]] && printf yes || printf no )" \
    "$(tui_bootstrap_missing_lines "$boot_snapshot")")"

  if [[ "$config_dir_exists" != "1" || "$inventory_ready" != "1" ]]; then
    TUI_SHORTCUT_CONTEXT="quickstart"
    init_choice="$(tui_menu_prompt_safe "First setup: config bootstrap" \
      full "Create core and optional starter templates" \
      minimal "Create only the core starter files" \
      review "Inspect effective config and docs first" \
      skip "Keep current files and continue")"
    init_choice="$(normalize_menu_choice "$init_choice")"
    case "$init_choice" in
      full)
        tui_run_cmd "linux-maint init" "$0" init
        ;;
      minimal)
        tui_run_cmd "linux-maint init --minimal" "$0" init --minimal
        ;;
      review)
        tui_run_cmd "linux-maint config --sources" "$0" config --sources
        ;;
    esac
  elif tui_yesno "Starter config already exists at $cfg_dir.\nReview effective config sources before the first run?"; then
    tui_run_cmd "linux-maint config --sources" "$0" config --sources
  fi

  if [[ "$inventory_ready" != "1" ]]; then
    tui_msgbox "Add targets before the first run:\n- edit $serverlist\n- or create group files under $hosts_dir"
  fi

  quickref="$(find_doc_file QUICK_REFERENCE.md)"
  if tui_yesno "Open the quick reference before the first live run?"; then
    tui_view_file "Quick reference" "$quickref"
  fi

  if [[ "$optional_skips_present" == "1" ]]; then
    optional_banner="$(tui_optional_skip_lines "$cfg_dir" 6)"
    tui_msgbox "Optional monitor inputs still missing:\n$optional_banner\n\nThis is expected unless you want those checks enabled from day one."
  fi

  if tui_yesno "Run readiness checks now?\nRecommended before the first live run."; then
    tui_run_cmd "linux-maint check" "$0" check
  fi

  if tui_yesno "Preview the first run plan now?"; then
    tui_run_cmd "linux-maint run --plan" "$0" run --plan
  fi

  choice="$(tui_menu_prompt_safe "First setup: next guide" \
    monitors "Review monitor requirements and optional inputs" \
    baselines "Capture starter local baselines" \
    finish "Finish bootstrap")"
  choice="$(normalize_menu_choice "$choice")"
  case "$choice" in
    monitors)
      tui_run_cmd "linux-maint list-monitors" "$0" list-monitors
      ;;
    baselines)
      tui_bootstrap_baseline_wizard
      ;;
  esac

  tui_msgbox "Bootstrap complete.\n\nRecommended next steps:\n$(tui_bootstrap_next_steps_lines)"
}

tui_quickstart_current_incident(){
  if ! tui_has_summary_snapshot && ! tui_has_latest_log; then
    tui_msgbox "Current incident mode is strongest after you have at least one summary or wrapper log.\n\nStart with first setup, run check, and preview the first run first."
    if tui_yesno "Open first setup now?"; then
      tui_quickstart_first_setup
    fi
    return 0
  fi
  run_menu_incident_mode
}

tui_quickstart_escalation(){
  if ! tui_has_summary_snapshot && ! tui_has_latest_log && ! tui_has_history_artifacts; then
    tui_msgbox "There are no current artifacts to export yet.\n\nStart with first setup, then run check or a real run before using escalation."
    if tui_yesno "Open first setup now?"; then
      tui_quickstart_first_setup
    fi
    return 0
  fi
  tui_msgbox "Escalation flow:\n1. capture a short human summary\n2. export machine-readable JSON\n3. create a support bundle"
  tui_run_cmd "linux-maint report --short --no-trend" "$0" report --short --no-trend
  tui_run_cmd "linux-maint export --json" "$0" export --json
  tui_pack_logs_wizard || true
}

run_menu_quickstart(){
  while true; do
    local choice
    TUI_SHORTCUT_CONTEXT="quickstart"
    choice="$(tui_menu_prompt_safe "Quickstart" \
      first_setup "Guide: first setup and safe first run [f]" \
      current_incident "Guide: current incident triage [i]" \
      escalation "Guide: export and escalation workflow [e]" \
      inventory "Edit: servers.txt inventory [s]" \
      groups "Open: hosts.d groups overview [g]" \
      docs "Open: setup docs [d]" \
      back "Back to main menu [b]")"
    local rc=$TUI_MENU_RC
    if [[ $rc -ne 0 || -z "${choice:-}" ]]; then
      break
    fi
    choice="$(normalize_menu_choice "$choice")"
    choice="$(map_menu_shortcut "$choice" "quickstart")"
    case "$choice" in
      first_setup) tui_quickstart_first_setup ;;
      current_incident) tui_quickstart_current_incident ;;
      escalation) tui_quickstart_escalation ;;
      inventory) tui_quickstart_inventory_edit ;;
      groups) tui_quickstart_groups_overview ;;
      docs) tui_quickstart_docs ;;
      back) break ;;
    esac
    if [[ "${TUI_RETURN_TO_MAIN:-0}" == "1" ]]; then
      break
    fi
  done
}

tui_gum_current_pressure_card(){
  local status_json="${1:-}" width="${2:-52}"
  if ! tui_has_summary_snapshot; then
    tui_gum_card_render "Current pressure" "#14b8a6" "$(printf '%s\n%s\n%s' \
      "no active snapshot yet" \
      "Use first setup to get config, check, and plan into a known-good state." \
      "Then return here for live incident focus.")" "$width"
    return 0
  fi
  local focus top_reason top_monitor top_host overall
  focus="$(tui_status_focus_snapshot "$status_json")"
  overall="$(printf '%s\n' "$focus" | awk -F= '/^overall=/{print $2; exit}')"
  top_reason="$(printf '%s\n' "$focus" | awk -F= '/^top_reason=/{print $2; exit}')"
  top_monitor="$(printf '%s\n' "$focus" | awk -F= '/^top_monitor=/{print $2; exit}')"
  top_host="$(printf '%s\n' "$focus" | awk -F= '/^top_host=/{print $2; exit}')"
  tui_gum_card_render "Current pressure" "#f59e0b" "$(printf '%s\n%s\n%s' \
    "overall=${overall:-UNKNOWN}" \
    "top_reason=${top_reason:--}" \
    "top_problem=${top_monitor:--} host=${top_host:--}")" "$width"
}

tui_menu_help_overlay_text(){
  local prompt="$1" context="$2" catalog="$3"
  local shortcuts_label="off"
  tui_bool_enabled "${LM_TUI_SHORTCUTS:-0}" && shortcuts_label="on"
  {
    printf 'Section: %s\n\n' "$prompt"
    printf 'Controls:\n'
    printf -- '- Use arrows to move through the chooser\n'
    printf -- '- Enter selects the highlighted action\n'
    printf -- '- Search opens the smart command palette (names, aliases, task words)\n'
    printf -- '- Preview opens action previews for the current menu\n'
    printf -- '- Help reopens this quick controls overlay\n'
    printf -- '- Esc goes back\n'
    printf -- '- optional shortcuts are %s\n' "$shortcuts_label"
    printf '\nPalette examples:\n'
    printf -- '- try: first run, triage, bundle, report, logs, doctor\n'
    printf '\nActions:\n'
    while IFS='|' read -r tag desc; do
      [[ -n "${tag:-}" ]] || continue
      printf -- '- %s: %s\n' "$tag" "$desc"
    done <<< "$catalog"
  }
}

tui_textbox_text(){
  local title="$1" content="$2"
  local tmp
  tmp="$(mktemp -p "$TMPDIR" linux_maint_textbox.XXXXXX)"
  printf '%s\n' "$content" > "$tmp"
  tui_textbox "$title" "$tmp"
  rm -f "$tmp" 2>/dev/null || true
}

tui_preferred_editor(){
  local editor="${VISUAL:-${EDITOR:-}}"
  if [[ -n "$editor" ]] && command -v "${editor%% *}" >/dev/null 2>&1; then
    printf '%s' "$editor"
    return 0
  fi
  local candidate
  for candidate in sensible-editor editor nano vi vim; do
    if command -v "$candidate" >/dev/null 2>&1; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

tui_edit_file(){
  local title="$1" file="$2"
  mkdir -p "$(dirname "$file")" 2>/dev/null || true
  touch "$file" 2>/dev/null || true
  local editor
  if ! editor="$(tui_preferred_editor)"; then
    tui_view_file "$title" "$file"
    return 0
  fi
  clear 2>/dev/null || true
  echo "Opening $file with $editor" >&2
  "$editor" "$file" </dev/tty >/dev/tty 2>/dev/tty || true
}

tui_hosts_dir_overview_text(){
  local hosts_dir="${1:-$(tui_effective_hosts_dir)}"
  printf 'hosts.d overview\n\n'
  printf 'Path: %s\n\n' "$hosts_dir"
  if [[ -d "$hosts_dir" ]] && compgen -G "$hosts_dir/*.txt" >/dev/null 2>&1; then
    printf 'Current group files:\n'
    find "$hosts_dir" -maxdepth 1 -type f -name '*.txt' -printf '  - %f\n' | sort
  else
    printf 'Current group files:\n'
    printf '  - none yet\n'
  fi
  printf '\nExpected usage:\n'
  printf '  - one group per file\n'
  printf '  - file name becomes the --group target\n'
  printf '  - each file contains one host per line\n'
}

tui_quickstart_inventory_edit(){
  local serverlist
  serverlist="$(tui_effective_serverlist_path)"
  tui_edit_file "servers.txt inventory" "$serverlist"
}

tui_quickstart_groups_overview(){
  local hosts_dir
  hosts_dir="$(tui_effective_hosts_dir)"
  mkdir -p "$hosts_dir" 2>/dev/null || true
  tui_textbox_text "hosts.d groups" "$(tui_hosts_dir_overview_text "$hosts_dir")"
}

tui_quickstart_docs(){
  local choice quickref troubleshooting
  quickref="$(find_doc_file QUICK_REFERENCE.md)"
  troubleshooting="$(find_doc_file troubleshooting.md)"
  choice="$(tui_menu_prompt_safe "Quickstart docs" \
    quickref "Open quick reference" \
    troubleshooting "Open troubleshooting guide" \
    back "Back")"
  [[ "$TUI_MENU_RC" -eq 0 && -n "${choice:-}" ]] || return 0
  choice="$(normalize_menu_choice "$choice")"
  case "$choice" in
    quickref) tui_view_file "Quick reference" "$quickref" ;;
    troubleshooting) tui_view_file "Troubleshooting" "$troubleshooting" ;;
  esac
}

