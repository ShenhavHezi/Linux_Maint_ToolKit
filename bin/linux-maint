def parse_timestamp(ts):
    if not ts:
        return -1
    try:
        if ts.endswith("Z"):
            dt = datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
        else:
            dt = datetime.strptime(ts, "%Y-%m-%dT%H:%M:%S%z")
        return int(dt.timestamp())
    except Exception:
        return -1

