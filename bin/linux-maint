              warn_ms[a[1]] = a[2] * 1000
            }
          } while ((getline line < warn_file) > 0)
          close(warn_file)
        }
      }
      {
        ms=$1; mon=$2
        line="monitor="mon" ms="ms
        if (color == 1 && (mon in warn_ms) && ms >= warn_ms[mon]) {
