}

tui_preview_cmd(){
  case "${LM_TUI_PREVIEW:-1}" in
    1|true|TRUE|yes|YES|on|ON) ;;
    *) return 0 ;;
  esac
  local cmd_text="$*"
  if [[ "$TUI_BACKEND" == "gum" ]]; then
    tui_gum_hint "Will run: $cmd_text"
  else
    echo "Will run: $cmd_text" >&2
  fi
}

severity_symbol(){
  case "$1" in
    CRIT) printf '!!' ;;
    WARN) printf '! ' ;;
    OK) printf 'OK' ;;
    UNKNOWN) printf '??' ;;
    SKIP) printf '--' ;;
    *) printf '..' ;;
  esac
}

menu_settings_path(){
  local cfg_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  printf '%s/linux-maint/menu.conf' "$cfg_home"
}

sanitize_int_range(){
  local int_raw="$1" min="$2" max="$3" fallback="$4"
  if [[ "$int_raw" =~ ^[0-9]+$ ]]; then
    if (( int_raw < min )); then
      printf '%s' "$min"
      return 0
    fi
    if (( int_raw > max )); then
      printf '%s' "$max"
      return 0
    fi
    printf '%s' "$int_raw"
    return 0
  fi
  printf '%s' "$fallback"
}

normalize_menu_settings(){
  local backend="${LM_TUI_BACKEND:-}"
  case "$backend" in
    ""|gum|dialog|whiptail) ;;
    *) unset LM_TUI_BACKEND ;;
  esac
  LM_TUI_DASH_REFRESH="$(sanitize_int_range "${LM_TUI_DASH_REFRESH:-0}" 0 300 0)"
  LM_TUI_DEFAULT_PROBLEMS="$(sanitize_int_range "${LM_TUI_DEFAULT_PROBLEMS:-20}" 1 100 20)"
  LM_TUI_DEFAULT_REASONS="$(sanitize_int_range "${LM_TUI_DEFAULT_REASONS:-5}" 0 20 5)"
  case "${LM_TUI_DEFAULT_STATUS_VIEW:-table}" in
    table|compact) ;;
    *) LM_TUI_DEFAULT_STATUS_VIEW="table" ;;
  esac
  case "${LM_TUI_PREVIEW:-1}" in
    1|0|true|false|TRUE|FALSE|yes|no|YES|NO|on|off|ON|OFF) ;;
    *) LM_TUI_PREVIEW=1 ;;
  esac
  case "${LM_TUI_SHORTCUTS:-1}" in
    1|0|true|false|TRUE|FALSE|yes|no|YES|NO|on|off|ON|OFF) ;;
    *) LM_TUI_SHORTCUTS=1 ;;
  esac
  case "${LM_TUI_COMPACT:-0}" in
    1|0|true|false|TRUE|FALSE|yes|no|YES|NO|on|off|ON|OFF) ;;
    *) LM_TUI_COMPACT=0 ;;
  esac
  case "${LM_TUI_LOW_COLOR:-0}" in
    1|0|true|false|TRUE|FALSE|yes|no|YES|NO|on|off|ON|OFF) ;;
    *) LM_TUI_LOW_COLOR=0 ;;
  esac
  case "${LM_TUI_CONFIRM_RISKY:-1}" in
    1|0|true|false|TRUE|FALSE|yes|no|YES|NO|on|off|ON|OFF) ;;
    *) LM_TUI_CONFIRM_RISKY=1 ;;
  esac
  export LM_TUI_DASH_REFRESH LM_TUI_DEFAULT_PROBLEMS LM_TUI_DEFAULT_REASONS LM_TUI_DEFAULT_STATUS_VIEW LM_TUI_PREVIEW LM_TUI_SHORTCUTS LM_TUI_COMPACT LM_TUI_LOW_COLOR LM_TUI_CONFIRM_RISKY
}

load_menu_settings(){
  local f
  f="$(menu_settings_path)"
  [[ -f "$f" ]] || return 0
  while IFS='=' read -r k v; do
    [[ -n "$k" ]] || continue
    [[ "$k" =~ ^[A-Z0-9_]+$ ]] || continue
    case "$k" in
      LM_TUI_BACKEND|LM_TUI_DASH_REFRESH|LM_TUI_DEFAULT_STATUS_VIEW|LM_TUI_DEFAULT_PROBLEMS|LM_TUI_DEFAULT_REASONS|LM_TUI_PREVIEW|LM_TUI_SHORTCUTS|LM_TUI_COMPACT|LM_TUI_LOW_COLOR|LM_TUI_CONFIRM_RISKY)
        v="${v%\"}"; v="${v#\"}"
        case "$v" in
          *$'\n'*|*$'\r'*) continue ;;
        esac
        export "$k=$v"
        ;;
    esac
  done < "$f"
  normalize_menu_settings
}

save_menu_settings(){
  normalize_menu_settings
  local f d
  f="$(menu_settings_path)"
  d="$(dirname "$f")"
  mkdir -p "$d" 2>/dev/null || return 1
  cat > "$f" <<EOF
LM_TUI_BACKEND=${LM_TUI_BACKEND:-}
LM_TUI_DASH_REFRESH=${LM_TUI_DASH_REFRESH:-0}
LM_TUI_DEFAULT_STATUS_VIEW=${LM_TUI_DEFAULT_STATUS_VIEW:-table}
LM_TUI_DEFAULT_PROBLEMS=${LM_TUI_DEFAULT_PROBLEMS:-20}
LM_TUI_DEFAULT_REASONS=${LM_TUI_DEFAULT_REASONS:-5}
LM_TUI_PREVIEW=${LM_TUI_PREVIEW:-1}
LM_TUI_SHORTCUTS=${LM_TUI_SHORTCUTS:-1}
LM_TUI_COMPACT=${LM_TUI_COMPACT:-0}
LM_TUI_LOW_COLOR=${LM_TUI_LOW_COLOR:-0}
LM_TUI_CONFIRM_RISKY=${LM_TUI_CONFIRM_RISKY:-1}
EOF
}

menu_settings_reset_defaults(){
  unset LM_TUI_BACKEND
  export LM_TUI_DASH_REFRESH=0
  export LM_TUI_DEFAULT_STATUS_VIEW=table
  export LM_TUI_DEFAULT_PROBLEMS=20
  export LM_TUI_DEFAULT_REASONS=5
  export LM_TUI_PREVIEW=1
  export LM_TUI_SHORTCUTS=1
  export LM_TUI_COMPACT=0
  export LM_TUI_LOW_COLOR=0
  export LM_TUI_CONFIRM_RISKY=1
}

tui_command_risk_level(){
  local argv0="${1:-}" sub="${2:-}"
  case "$sub" in
    run|doctor) printf 'changes' ;;
    pack-logs) printf 'changes' ;;
    *) printf 'read-only' ;;
  esac
}

tui_command_risk_badge(){
  case "$1" in
    changes) printf 'Changes system' ;;
    read-only) printf 'Read-only' ;;
    *) printf 'Safe' ;;
  esac
}

tui_bool_enabled(){
  case "${1:-0}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

tui_command_confirm_if_needed(){
  local cmd_text="$1" risk="$2"
  if [[ "$risk" != "changes" ]]; then
    return 0
  fi
  if ! tui_bool_enabled "${LM_TUI_CONFIRM_RISKY:-1}"; then
    return 0
  fi
  tui_yesno "This action may change system state.\nRisk: $(tui_command_risk_badge "$risk")\n\nRun command?\n$cmd_text"
}

tui_post_action_choice(){
  if [[ "$TUI_BACKEND" == "gum" ]]; then
    tui_gum_hint "Next: [r]erun  [b]ack  [m]ain menu"
    local key
    IFS= read -rsn1 key < /dev/tty || { printf 'back'; return 0; }
    case "$key" in
      r|R) printf 'rerun' ;;
      m|M) printf 'main' ;;
      *) printf 'back' ;;
    esac
    return 0
  fi
  local c
  c="$(tui_menu_prompt_safe "Next action" rerun "Run again" back "Back to current menu" main "Return to main menu")"
  if [[ "$TUI_MENU_RC" -ne 0 || -z "${c:-}" ]]; then
    printf 'back'
    return 0
  fi
  c="$(normalize_menu_choice "$c")"
  case "$c" in
    rerun|main|back) printf '%s' "$c" ;;
    *) printf 'back' ;;
  esac
}

tui_action_result_card(){
  local title="$1" rc="$2" elapsed="$3" cmd_text="$4" risk="$5"
  local status="OK"
  [[ "$rc" -eq 0 ]] || status="FAIL"
  local log_file
  log_file="$(tui_latest_log_path)"
  local next_hint
  if [[ "$rc" -eq 0 ]]; then
    next_hint="Tip: check report/trend for quick validation."
  else
    next_hint="Tip: run diagnostics (doctor/logs) for triage."
  fi
  local msg="Result: $status (exit=$rc)\nRisk: $(tui_command_risk_badge "$risk")\nElapsed: ${elapsed}s\nLog: $log_file\nCmd: $cmd_text\n\n$next_hint"
  tui_msgbox "$msg"
}

tui_input(){
  local prompt="$1"
  local placeholder="${2:-}"
  local out rc
  TUI_INPUT_RC=0
  set +e
  if [[ "$TUI_BACKEND" == "gum" ]]; then
    out="$(gum input --prompt "$prompt: " --placeholder "$placeholder")"
    rc=$?
  elif [[ "$TUI_BACKEND" == "dialog" ]]; then
    out="$(dialog --clear --backtitle "$TUI_BACKTITLE" --title "$TUI_TITLE" \
      --inputbox "$prompt" 10 70 "$placeholder" 3>&1 1>&2 2>&3)"
    rc=$?
  else
    out="$(whiptail --title "$TUI_TITLE" --inputbox "$prompt" 10 70 "$placeholder" 3>&1 1>&2 2>&3)"
    rc=$?
  fi
  set -e
  TUI_INPUT_RC="$rc"
  printf '%s' "$out"
  return "$rc"
}

tui_input_capture(){
  local prompt="$1"
  local placeholder="${2:-}"
  local out rc
  TUI_INPUT_VALUE=""
  TUI_INPUT_RC=0
  set +e
  out="$(tui_input "$prompt" "$placeholder")"
  rc=$?
  set -e
  TUI_INPUT_VALUE="$out"
  TUI_INPUT_RC="$rc"
  return 0
}

tui_view_file(){
  local title="$1"
  local file="$2"
  if [[ -f "$file" ]]; then
    tui_textbox "$title" "$file"
  else
    tui_msgbox "File not found: $file"
  fi
}

find_doc_file(){
  local name="$1"
  local -a candidates=(
    "$REPO_ROOT/docs/$name"
    "$SHARE/docs/$name"
    "$PREFIX/share/Linux_Maint_ToolKit/docs/$name"
    "$PREFIX/share/linux-maint/docs/$name"
    "/usr/local/share/Linux_Maint_ToolKit/docs/$name"
    "/usr/share/Linux_Maint_ToolKit/docs/$name"
    "/usr/share/linux-maint/docs/$name"
    "/usr/share/linux_maint/docs/$name"
  )
  local p
  for p in "${candidates[@]}"; do
    if [[ -f "$p" ]]; then
      printf '%s' "$p"
      return 0
    fi
  done
  printf '%s' "$REPO_ROOT/docs/$name"
  return 1
}

tui_msgbox(){
  local msg="$1"
  local rendered
  rendered="$(printf '%b' "$msg")"
  if [[ "$TUI_BACKEND" == "gum" ]]; then
    gum style --border normal --border-foreground "#3b82f6" --padding "1 3" --margin "1 1" \
      --foreground "#f9fafb" "$rendered" >&2
    read -r -p "Press Enter to continue..." _ </dev/tty
  elif [[ "$TUI_BACKEND" == "dialog" ]]; then
    dialog --clear --backtitle "$TUI_BACKTITLE" --title "$TUI_TITLE" \
      --msgbox "$rendered" 10 70
  else
    whiptail --title "$TUI_TITLE" --msgbox "$rendered" 10 70
  fi
}

tui_yesno(){
  local msg="$1"
  local rendered
  rendered="$(printf '%b' "$msg")"
  if [[ "$TUI_BACKEND" == "gum" ]]; then
    gum confirm "$rendered"
  elif [[ "$TUI_BACKEND" == "dialog" ]]; then
    dialog --clear --backtitle "$TUI_BACKTITLE" --title "$TUI_TITLE" \
      --yesno "$rendered" 10 70
  else
    whiptail --title "$TUI_TITLE" --yesno "$rendered" 10 70
  fi
}

tui_textbox(){
  local title="$1"
  local file="$2"
  if [[ "$TUI_BACKEND" == "gum" ]]; then
    gum style --bold --foreground "#f9fafb" "$title" >&2
    gum pager < "$file" || true
  elif [[ "$TUI_BACKEND" == "dialog" ]]; then
    dialog --clear --backtitle "$TUI_BACKTITLE" --title "$title" \
      --textbox "$file" 22 90
  else
    whiptail --title "$title" --textbox "$file" 22 90
  fi
}

tui_colorize_file(){
  local in="$1"
  local out="$2"
  python3 - "$in" "$out" <<'PY'
import re
import sys

src, dst = sys.argv[1:3]
colors = {
    "CRIT": "\033[31m",
    "WARN": "\033[33m",
    "OK": "\033[32m",
    "UNKNOWN": "\033[34m",
    "SKIP": "\033[90m",
}
reset = "\033[0m"
status_re = re.compile(r"\b(CRIT|WARN|OK|UNKNOWN|SKIP)\b")
error_re = re.compile(r"^\s*ERROR\b", re.IGNORECASE)
warn_re = re.compile(r"^\s*WARN\b", re.IGNORECASE)

with open(src, "r", encoding="utf-8", errors="ignore") as f, open(dst, "w", encoding="utf-8") as o:
    for line in f:
        line = status_re.sub(lambda m: colors.get(m.group(1), "") + m.group(1) + reset, line)
        if error_re.search(line):
            line = "\033[31m" + line.rstrip("\n") + reset + "\n"
        elif warn_re.search(line):
            line = "\033[33m" + line.rstrip("\n") + reset + "\n"
        o.write(line)
PY
}

tui_run_cmd(){
  local title="$1"
  shift || true
  local cmd_text="$*"
  local sub="${2:-}"
  local risk
  risk="$(tui_command_risk_level "${1:-}" "$sub")"
  local interactive=1
  if ! [[ -t 0 && -t 1 && -t 2 ]]; then
    interactive=0
  fi
  while true; do
    tui_preview_cmd "$@"
    if [[ "$interactive" -eq 1 ]] && ! tui_command_confirm_if_needed "$cmd_text" "$risk"; then
      return 130
    fi
    local out
    out="$(mktemp -p "$TMPDIR" linux_maint_menu.XXXXXX)"
    local start_ts end_ts elapsed
    start_ts="$(date +%s)"
    set +e
    NO_COLOR=1 "$@" >"$out" 2>&1 </dev/null
    local rc=$?
    set -e
    end_ts="$(date +%s)"
    elapsed=$(( end_ts - start_ts ))
    local label="$title"
    local view_file="$out"
    if [[ $rc -ne 0 ]]; then
      label="$title (exit $rc)"
    fi
    if [[ "$TUI_BACKEND" == "gum" ]]; then
      local colored
      colored="$(mktemp -p "$TMPDIR" linux_maint_menu_color.XXXXXX)"
      if tui_bool_enabled "${LM_TUI_LOW_COLOR:-0}"; then
        cp -f "$out" "$colored"
      else
        tui_colorize_file "$out" "$colored"
      fi
      view_file="$colored"
    fi
    tui_textbox "$label" "$view_file"
    rm -f "$out"
    [[ -n "${colored:-}" ]] && rm -f "$colored"
    if [[ "$interactive" -eq 1 ]]; then
      tui_action_result_card "$title" "$rc" "$elapsed" "$cmd_text" "$risk"
      local next
      next="$(tui_post_action_choice)"
      case "$next" in
        rerun) continue ;;
        main) TUI_RETURN_TO_MAIN=1 ;;
      esac
    fi
    return $rc
  done
}

tui_run_live(){
  local title="$1"
  shift || true
  local cmd_text="$*"
  local sub="${2:-}"
  local risk
  risk="$(tui_command_risk_level "${1:-}" "$sub")"
  local interactive=1
  if ! [[ -t 0 && -t 1 && -t 2 ]]; then
    interactive=0
  fi
  tui_preview_cmd "$@"
  if [[ "$interactive" -eq 1 ]] && ! tui_command_confirm_if_needed "$cmd_text" "$risk"; then
    return 130
  fi
  if [[ "$TUI_BACKEND" == "gum" ]]; then
    clear
    tui_gum_header "Linux Maint ToolKit" "$title"
    tui_gum_hint "Live output. Press Ctrl+C to stop."
    local start_ts end_ts elapsed
    start_ts="$(date +%s)"
    set +e
    env LM_PROGRESS=1 LM_PROGRESS_MODE=plain LM_PROGRESS_FORCE=1 LM_PROGRESS_WIDTH=32 "$@" </dev/null
    local rc=$?
    set -e
    end_ts="$(date +%s)"
    elapsed=$(( end_ts - start_ts ))
    if [[ "$interactive" -eq 1 ]]; then
      tui_action_result_card "$title" "$rc" "$elapsed" "$cmd_text" "$risk"
      local next
      next="$(tui_post_action_choice)"
      case "$next" in
        rerun) tui_run_live "$title" "$@"; return $? ;;
        main) TUI_RETURN_TO_MAIN=1 ;;
      esac
    fi
    return $rc
  fi
  if [[ "$TUI_BACKEND" == "dialog" ]]; then
    dialog --clear --backtitle "$TUI_BACKTITLE" --title "$title" \
      --programbox "$title" 22 90 env NO_COLOR=1 LM_PROGRESS=1 LM_PROGRESS_MODE=plain LM_PROGRESS_FORCE=1 LM_PROGRESS_WIDTH=32 "$@" || true
    return 0
  fi
  tui_run_cmd "$title" "$@"
}

tui_default_pack_logs_out(){
  if [[ "$MODE" == "repo" ]]; then
    printf '%s' "$REPO_ROOT"
  else
    printf '.'
  fi
}

tui_support_bundle_summary(){
  local search_dir="${1:-/tmp}" redact="${2:-1}"
  local bundle
  bundle="$(find "$search_dir" -maxdepth 1 -type f \( -name 'linux_maint_support*.tar.gz' -o -name 'linux_maint*.tar.gz' -o -name 'linux_maint_support*.tar.gz.gpg' -o -name 'linux_maint*.tar.gz.gpg' \) -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n 1 | awk '{print $2}')"
  [[ -n "$bundle" && -f "$bundle" ]] || return 0
  local sha
  sha="$(sha256sum "$bundle" 2>/dev/null | awk '{print $1}')"
  local msg="Support bundle created:\n$bundle"
  [[ -n "$sha" ]] && msg="${msg}\nsha256=$sha"
  if [[ "$bundle" == *.gpg ]]; then
    msg="${msg}\nencrypted=yes"
  elif [[ -f "$bundle.gpg" ]]; then
    msg="${msg}\nencrypted=$bundle.gpg"
  fi
  if [[ "$redact" -eq 1 ]]; then
    msg="${msg}\nredaction=enabled"
  else
    msg="${msg}\nredaction=disabled"
  fi
  tui_msgbox "$msg"
}

tui_pack_logs_wizard(){
  local out_dir redact hash encrypt recipient keep_plain cmd_display
  out_dir="$(tui_default_pack_logs_out)"
  redact=1
  hash=1
  encrypt=0
  recipient=""
  keep_plain=0

  tui_input_capture "Support bundle output directory" "$out_dir"
  [[ "$TUI_INPUT_RC" -eq 0 ]] || return 130
  if [[ -n "${TUI_INPUT_VALUE:-}" ]]; then
    out_dir="$TUI_INPUT_VALUE"
  fi
  [[ -n "$out_dir" ]] || out_dir="$(tui_default_pack_logs_out)"

  if ! tui_yesno "Redact sensitive data in the support bundle?\nRecommended: yes"; then
    redact=0
  fi
  if tui_yesno "Include a SHA256 manifest with the bundle?\nRecommended: yes"; then
    hash=1
  else
    hash=0
  fi
  if tui_yesno "Encrypt the bundle with GPG before sharing?"; then
    encrypt=1
    tui_input_capture "GPG recipient" "email or key id"
    [[ "$TUI_INPUT_RC" -eq 0 ]] || return 130
    recipient="${TUI_INPUT_VALUE:-}"
    if [[ -z "$recipient" ]]; then
      tui_msgbox "GPG recipient is required when encryption is enabled."
      return 1
    fi
    if tui_yesno "Keep the plaintext .tar.gz alongside the encrypted .gpg bundle?"; then
      keep_plain=1
    fi
  fi

  local -a cmd=("$0" pack-logs --out "$out_dir")
  if [[ "$redact" -eq 1 ]]; then
    cmd+=(--redact)
  else
    cmd+=(--no-redact)
  fi
  if [[ "$hash" -eq 1 ]]; then
    cmd+=(--hash)
  fi
  if [[ "$encrypt" -eq 1 ]]; then
    cmd+=(--gpg --gpg-recipient "$recipient")
    if [[ "$keep_plain" -eq 1 ]]; then
      cmd+=(--gpg-keep-plaintext)
    fi
  fi

  cmd_display="linux-maint pack-logs --out $out_dir"
  if [[ "$redact" -eq 1 ]]; then
    cmd_display="$cmd_display --redact"
  else
    cmd_display="$cmd_display --no-redact"
  fi
  if [[ "$hash" -eq 1 ]]; then
    cmd_display="$cmd_display --hash"
  fi
  if [[ "$encrypt" -eq 1 ]]; then
    cmd_display="$cmd_display --gpg --gpg-recipient $recipient"
    if [[ "$keep_plain" -eq 1 ]]; then
      cmd_display="$cmd_display --gpg-keep-plaintext"
    fi
  fi

  if ! tui_yesno "Create support bundle with these settings?\n$cmd_display"; then
    return 130
  fi
  tui_run_cmd "linux-maint pack-logs" "${cmd[@]}"
  local rc=$?
  if [[ "$rc" -eq 0 ]]; then
    tui_support_bundle_summary "$out_dir" "$redact"
  fi
  return "$rc"
}

tui_recent_artifacts_block(){
  local summary log statusf
  local log_dir
  log_dir="$(tui_effective_log_dir)"
  summary="$log_dir/full_health_monitor_summary_latest.log"
  log="$log_dir/full_health_monitor_latest.log"
  statusf="$log_dir/last_status_full"
  local tmp
  tmp="$(mktemp -p "$TMPDIR" linux_maint_artifacts.XXXXXX)"
  {
    echo "Recent artifacts"
    for p in "$summary" "$log" "$statusf"; do
      if [[ -f "$p" ]]; then
        printf -- "- %s (%s)\n" "$p" "$(date -r "$p" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo unknown_time)"
      else
        printf -- "- %s (missing)\n" "$p"
      fi
    done
  } > "$tmp"
  if [[ "$TUI_BACKEND" == "gum" ]]; then
    gum style --border normal --border-foreground "#374151" --padding "1 2" --margin "0 1" \
      "$(cat "$tmp")" >&2
  else
    cat "$tmp" >&2
  fi
  rm -f "$tmp"
}

tui_menu_quick_actions(){
  local overall="$1" rc="$2"
  while true; do
    local choice
    if [[ "$overall" == "CRIT" || "$overall" == "WARN" || "$rc" -ne 0 ]]; then
      choice="$(tui_menu_prompt_safe "Quick actions" \
        doctor "Diagnose: run doctor checks" \
        reasons "Review: top reasons (10)" \
        logs "Inspect: latest logs (200 lines)" \
        pack "Support: create redacted bundle" \
        back "Back")"
    else
      choice="$(tui_menu_prompt_safe "Quick actions" \
        report "Review: short report" \
        trend "Analyze: trend (last 10 runs)" \
        back "Back")"
    fi
    [[ "$TUI_MENU_RC" -eq 0 && -n "${choice:-}" ]] || break
    choice="$(normalize_menu_choice "$choice")"
    case "$choice" in
      doctor) tui_run_cmd "linux-maint doctor" "$0" doctor ;;
      reasons) tui_run_cmd "linux-maint status --reasons 10" "$0" status --reasons 10 ;;
      logs) tui_run_cmd "linux-maint logs 200" "$0" logs 200 ;;
      pack)
        tui_pack_logs_wizard || true
        ;;
      report) tui_run_cmd "linux-maint report --short --no-trend" "$0" report --short --no-trend ;;
      trend) tui_run_cmd "linux-maint trend --last 10" "$0" trend --last 10 ;;
      back) break ;;
    esac
  done
}

tui_run_next_steps(){
  local rc="$1"
  local summary log log_dir
  log_dir="$(tui_effective_log_dir)"
  summary="$log_dir/full_health_monitor_summary_latest.log"
  log="$log_dir/full_health_monitor_latest.log"
  local status_json overall
  status_json="$(NO_COLOR=1 "$0" status --json 2>/dev/null || true)"
  overall="$(STATUS_JSON="$status_json" python3 - <<'PY'
import json, os
raw = os.environ.get("STATUS_JSON","")
try:
    data = json.loads(raw) if raw else {}
except Exception:
    data = {}
t = data.get("totals",{}) or {}
crit = int(t.get("CRIT",0) or 0); warn = int(t.get("WARN",0) or 0); unk = int(t.get("UNKNOWN",0) or 0); ok = int(t.get("OK",0) or 0)
if crit > 0: print("CRIT")
elif warn > 0: print("WARN")
elif unk > 0: print("UNKNOWN")
elif ok > 0: print("OK")
else: print("UNKNOWN")
PY
)"
  local msg
  msg="Run finished (exit_code=$rc)\nOverall=$overall\nSummary: $summary\nLog: $log"
  tui_msgbox "$msg"
  tui_menu_quick_actions "$overall" "$rc"
}

tui_about(){
  local build
  build="$("$0" version 2>/dev/null || true)"
  local bin_path
  bin_path="$(command -v linux-maint 2>/dev/null || echo "$0")"
  local msg="Linux-Maint\nmode=$MODE\nbinary=$bin_path"
  if [[ -n "$build" ]]; then
    msg="${msg}\n\nBuild info:\n$build"
  fi
  tui_msgbox "$msg"
}

tui_tail_logs(){
  local log_file
  log_file="$(tui_latest_log_path)"
  if [[ ! -f "$log_file" ]]; then
    tui_msgbox "No log yet: $log_file"
    return 1
  fi
  if [[ "$TUI_BACKEND" == "dialog" ]]; then
    dialog --clear --backtitle "$TUI_BACKTITLE" --title "Live log tail" \
      --tailbox "$log_file" 22 90 || true
    return 0
  fi
  if [[ "$TUI_BACKEND" == "gum" ]]; then
    clear
    tui_gum_header "Linux Maint ToolKit" "Live log tail"
    tui_gum_hint "Press Ctrl+C to stop tail and return."
  else
    echo "Press Ctrl+C to stop tail and return."
  fi
  set +e
  tail -n 200 -f "$log_file"
  set -e
}

tui_gum_dashboard(){
  local refresh_secs="${LM_TUI_DASH_REFRESH:-0}"
  [[ "$refresh_secs" =~ ^[0-9]+$ ]] || refresh_secs=0
  while true; do
    local status_json
    status_json="$(NO_COLOR=1 "$0" status --json --problems 8 --reasons 6 2>/dev/null || true)"
    clear
    tui_gum_header "Linux Maint ToolKit" "Dashboard"
    tui_gum_context_panel "$status_json"
    tui_gum_status_overview "$status_json"
    tui_recent_artifacts_block

    local problems_csv reasons_csv
    problems_csv="$(STATUS_JSON="$status_json" python3 - <<'PY'
import json, os, sys
from collections import deque
raw = os.environ.get("STATUS_JSON", "")
if not raw:
    sys.exit(0)
try:
    data = json.loads(raw)
except Exception:
    sys.exit(0)
rows = data.get("problems") or []
for row in rows[:8]:
    status = row.get("status","")
    monitor = row.get("monitor","")
    host = row.get("host","")
    reason = row.get("reason","")
    for v in (status, monitor, host, reason):
        if v is None:
            v = ""
    reason = str(reason).replace("|","/").replace("\n"," ")
    monitor = str(monitor).replace("|","/")
    host = str(host).replace("|","/")
    status = str(status).replace("|","/")
    print(f"{status}|{monitor}|{host}|{reason}")
PY
)"

    reasons_csv="$(STATUS_JSON="$status_json" python3 - <<'PY'
import json, os, sys
raw = os.environ.get("STATUS_JSON", "")
if not raw:
    sys.exit(0)
try:
    data = json.loads(raw)
except Exception:
    sys.exit(0)
rows = data.get("reason_rollup") or []
for row in rows[:6]:
    reason = row.get("reason","")
    count = row.get("count","")
    if reason is None:
        reason = ""
    reason = str(reason).replace("|","/").replace("\n"," ")
    print(f"{reason}|{count}")
PY
)"

    local problems_table reasons_table
    if [[ -n "$problems_csv" ]]; then
      problems_table="$(printf '%s\n' "$problems_csv" | gum table --separator "|" \
        --columns "Status,Monitor,Host,Reason" --border rounded --print \
        --border.foreground "#1f2937" --header.foreground "#93c5fd")"
    else
      problems_table="$(gum style --foreground "#9ca3af" "No problems detected.")"
    fi
    if [[ -n "$reasons_csv" ]]; then
      reasons_table="$(printf '%s\n' "$reasons_csv" | gum table --separator "|" \
        --columns "Reason,Count" --border rounded --print \
        --border.foreground "#1f2937" --header.foreground "#93c5fd")"
    else
      reasons_table="$(gum style --foreground "#9ca3af" "No top reasons yet.")"
    fi

    gum style --bold --foreground "#f9fafb" --margin "1 2" "Top problems" >&2
    echo "$problems_table" >&2
    gum style --bold --foreground "#f9fafb" --margin "1 2" "Top reasons" >&2
    echo "$reasons_table" >&2

    if [[ "$refresh_secs" -gt 0 ]]; then
      tui_gum_hint "Press r to refresh, q/Enter to return. Auto-refresh: ${refresh_secs}s."
    else
      tui_gum_hint "Press r to refresh, q/Enter to return. Auto-refresh: off."
    fi
    if [[ "$refresh_secs" -gt 0 ]]; then
      read -r -t "$refresh_secs" -n 1 key </dev/tty || true
    else
      read -r -n 1 key </dev/tty
    fi
    if [[ -n "${key:-}" ]]; then
      if [[ "$key" == $'\n' || "$key" == "q" || "$key" == "Q" || "$key" == $'\e' ]]; then
        break
      fi
      if [[ "$key" == "r" || "$key" == "R" ]]; then
        continue
      fi
    fi
  done
}

tui_status_drilldown_view(){
  local mode="$1" status_filter="$2" host_filter="$3" monitor_filter="$4" reason_filter="$5"
  local problems="${LM_TUI_DEFAULT_PROBLEMS:-20}" reasons="${LM_TUI_DEFAULT_REASONS:-5}"
  local tmp
  tmp="$(mktemp -p "$TMPDIR" linux_maint_drilldown.XXXXXX)"
  local drill_json
  if [[ -n "${LM_TUI_DRILL_JSON:-}" ]]; then
    drill_json="$LM_TUI_DRILL_JSON"
  else
    NO_COLOR=1 "$0" status --json --problems "$problems" --reasons "$reasons" > "$tmp.json" 2>/dev/null || true
    drill_json="$(cat "$tmp.json" 2>/dev/null || true)"
  fi
  DRILL_JSON="$drill_json" DRILL_MODE="$mode" DRILL_STATUS="$status_filter" DRILL_HOST="$host_filter" DRILL_MON="$monitor_filter" DRILL_REASON="$reason_filter" \
    python3 - <<'PY' > "$tmp"
import json, os
raw = os.environ.get("DRILL_JSON","")
mode = os.environ.get("DRILL_MODE","table")
st = os.environ.get("DRILL_STATUS","ANY")
hf = os.environ.get("DRILL_HOST","").lower()
mf = os.environ.get("DRILL_MON","").lower()
rf = os.environ.get("DRILL_REASON","").lower()
try:
    data = json.loads(raw) if raw else {}
except Exception:
    data = {}
rows = data.get("problems") or []
out = []
for r in rows:
    status = str(r.get("status",""))
    host = str(r.get("host",""))
    mon = str(r.get("monitor",""))
    reason = str(r.get("reason",""))
    if st not in ("", "ANY") and status != st:
      continue
    if hf and hf not in host.lower():
      continue
    if mf and mf not in mon.lower():
      continue
    if rf and rf not in reason.lower():
      continue
    out.append((status, mon, host, reason))
print(f"filters: status={st or 'ANY'} host={hf or '-'} monitor={mf or '-'} reason={rf or '-'}")
if not out:
    print("no rows matched")
else:
    if mode == "compact":
        for s,m,h,r in out:
            print(f"{s} {m} {h} {r}")
    else:
        print("STATUS   MONITOR                 HOST                    REASON")
        print("------   ----------------------  ----------------------  ------------------------------")
        for s,m,h,r in out:
            print(f"{s[:7]:<7}  {m[:22]:<22}  {h[:22]:<22}  {r[:30]}")
PY
  tui_textbox "Status drilldown ($mode)" "$tmp"
  rm -f "$tmp" "$tmp.json"
}

tui_status_drilldown_top_problem(){
  local status_filter="$1" host_filter="$2" monitor_filter="$3" reason_filter="$4"
  local problems="${LM_TUI_DEFAULT_PROBLEMS:-20}" reasons="${LM_TUI_DEFAULT_REASONS:-5}"
  local drill_json
  if [[ -n "${LM_TUI_DRILL_JSON:-}" ]]; then
    drill_json="$LM_TUI_DRILL_JSON"
  else
    drill_json="$(NO_COLOR=1 "$0" status --json --problems "$problems" --reasons "$reasons" 2>/dev/null || true)"
  fi
  DRILL_JSON="$drill_json" DRILL_STATUS="$status_filter" DRILL_HOST="$host_filter" DRILL_MON="$monitor_filter" DRILL_REASON="$reason_filter" \
    python3 - <<'PY'
import json, os
raw = os.environ.get("DRILL_JSON","")
st = os.environ.get("DRILL_STATUS","ANY")
hf = os.environ.get("DRILL_HOST","").lower()
mf = os.environ.get("DRILL_MON","").lower()
rf = os.environ.get("DRILL_REASON","").lower()
try:
    data = json.loads(raw) if raw else {}
except Exception:
    data = {}
for r in (data.get("problems") or []):
    status = str(r.get("status",""))
    host = str(r.get("host",""))
    mon = str(r.get("monitor",""))
    reason = str(r.get("reason",""))
    if st not in ("", "ANY") and status != st:
      continue
    if hf and hf not in host.lower():
      continue
    if mf and mf not in mon.lower():
      continue
    if rf and rf not in reason.lower():
      continue
    print(f"{mon}|{reason}")
    raise SystemExit(0)
PY
}

tui_status_drilldown(){
  local status_filter="ANY" host_filter="" monitor_filter="" reason_filter=""
  while true; do
    local choice
    TUI_SHORTCUT_CONTEXT="drilldown"
    choice="$(tui_menu_prompt_safe "Status drilldown" \
      table "View table with current filters [t]" \
      compact "View compact with current filters [c]" \
      set_status "Set status filter (current: $status_filter) [s]" \
      set_host "Set host filter (current: ${host_filter:--}) [h]" \
      set_monitor "Set monitor filter (current: ${monitor_filter:--}) [m]" \
      set_reason "Set reason filter (current: ${reason_filter:--}) [r]" \
      explain_reason "Explain a reason token [e]" \
      explain_monitor "Explain a monitor [o]" \
      explain_top "Explain top filtered problem [x]" \
      clear "Clear all filters [l]" \
      back "Back [q]")"
    [[ "$TUI_MENU_RC" -eq 0 && -n "${choice:-}" ]] || break
    choice="$(normalize_menu_choice "$choice")"
    choice="$(map_menu_shortcut "$choice" "drilldown")"
    case "$choice" in
      table) tui_status_drilldown_view "table" "$status_filter" "$host_filter" "$monitor_filter" "$reason_filter" ;;
      compact) tui_status_drilldown_view "compact" "$status_filter" "$host_filter" "$monitor_filter" "$reason_filter" ;;
      set_status)
        local s
        s="$(tui_menu_prompt_safe "Pick status filter" ANY "All statuses" OK "OK only" WARN "WARN only" CRIT "CRIT only" UNKNOWN "UNKNOWN only" SKIP "SKIP only" back "Back")"
        if [[ "$TUI_MENU_RC" -eq 0 && -n "${s:-}" ]]; then
          s="$(normalize_menu_choice "$s")"
          [[ "$s" != "back" ]] && status_filter="$s"
        fi
        ;;
      set_host)
        tui_input_capture "Host filter (contains)" "$host_filter"
        [[ "$TUI_INPUT_RC" -eq 0 ]] && host_filter="$TUI_INPUT_VALUE"
        ;;
      set_monitor)
        tui_input_capture "Monitor filter (contains)" "$monitor_filter"
        [[ "$TUI_INPUT_RC" -eq 0 ]] && monitor_filter="$TUI_INPUT_VALUE"
        ;;
      set_reason)
        tui_input_capture "Reason filter (contains)" "$reason_filter"
        [[ "$TUI_INPUT_RC" -eq 0 ]] && reason_filter="$TUI_INPUT_VALUE"
        ;;
      explain_reason)
        local token
        tui_input_capture "Reason token" "e.g. disk_full"
        token="$TUI_INPUT_VALUE"
        if [[ "$TUI_INPUT_RC" -eq 0 && -n "${token:-}" ]]; then
          tui_run_cmd "linux-maint explain reason $token" "$0" explain reason "$token"
        fi
        ;;
      explain_monitor)
        local mon
        tui_input_capture "Monitor name" "e.g. service_monitor"
        mon="$TUI_INPUT_VALUE"
        if [[ "$TUI_INPUT_RC" -eq 0 && -n "${mon:-}" ]]; then
          tui_run_cmd "linux-maint explain monitor $mon" "$0" explain monitor "$mon"
        fi
        ;;
      explain_top)
        local top mon reason
        top="$(tui_status_drilldown_top_problem "$status_filter" "$host_filter" "$monitor_filter" "$reason_filter" || true)"
        mon="${top%%|*}"
        reason="${top#*|}"
        if [[ -z "$top" || -z "$mon" || "$reason" == "$top" || -z "$reason" ]]; then
          tui_msgbox "No matching problem row to explain."
        else
          tui_run_cmd "linux-maint explain reason $reason" "$0" explain reason "$reason"
          tui_run_cmd "linux-maint explain monitor $mon" "$0" explain monitor "$mon"
        fi
        ;;
      clear)
        status_filter="ANY"; host_filter=""; monitor_filter=""; reason_filter=""
        ;;
      back) break ;;
    esac
    if [[ "${TUI_RETURN_TO_MAIN:-0}" == "1" ]]; then
      break
    fi
  done
}

tui_run_wizard(){
  local scope="all" only="" skip="" target="local" group="" hosts="" mode="run"
  local c
  c="$(tui_menu_prompt_safe "Run wizard: scope" all "All monitors" only "Only selected monitors" skip "Skip selected monitors" back "Back")"
  [[ "$TUI_MENU_RC" -eq 0 && -n "${c:-}" ]] || return 0
  c="$(normalize_menu_choice "$c")"
  [[ "$c" == "back" ]] && return 0
  scope="$c"
  if [[ "$scope" == "only" ]]; then
    tui_input_capture "Only monitors (csv)" "service_monitor,ntp_drift_monitor"
    only="$TUI_INPUT_VALUE"
    [[ "$TUI_INPUT_RC" -eq 0 && -n "${only:-}" ]] || return 0
  elif [[ "$scope" == "skip" ]]; then
    tui_input_capture "Skip monitors (csv)" "inventory_export,backup_check"
    skip="$TUI_INPUT_VALUE"
    [[ "$TUI_INPUT_RC" -eq 0 && -n "${skip:-}" ]] || return 0
  fi

  c="$(tui_menu_prompt_safe "Run wizard: target" local "Local only" group "Group from hosts.d" hosts "Ad-hoc hosts list" back "Back")"
  [[ "$TUI_MENU_RC" -eq 0 && -n "${c:-}" ]] || return 0
  c="$(normalize_menu_choice "$c")"
  [[ "$c" == "back" ]] && return 0
  target="$c"
  case "$target" in
    group)
      tui_input_capture "Group name" "prod"
      group="$TUI_INPUT_VALUE"
      [[ "$TUI_INPUT_RC" -eq 0 && -n "${group:-}" ]] || return 0
      ;;
    hosts)
      tui_input_capture "Hosts (csv)" "server-a,server-b"
      hosts="$TUI_INPUT_VALUE"
      [[ "$TUI_INPUT_RC" -eq 0 && -n "${hosts:-}" ]] || return 0
      ;;
  esac

  c="$(tui_menu_prompt_safe "Run wizard: mode" run "Execute now" plan "Plan only (no execution)" back "Back")"
  [[ "$TUI_MENU_RC" -eq 0 && -n "${c:-}" ]] || return 0
  c="$(normalize_menu_choice "$c")"
  [[ "$c" == "back" ]] && return 0
  mode="$c"

  local -a cmd
  cmd=("$0" run)
  case "$scope" in
    only) cmd+=(--only "$only") ;;
    skip) cmd+=(--skip "$skip") ;;
  esac
  case "$target" in
    local) cmd+=(--local-only) ;;
    group) cmd+=(--group "$group") ;;
    hosts) cmd+=(--hosts "$hosts") ;;
  esac
  [[ "$mode" == "plan" ]] && cmd+=(--plan)
  if [[ "$mode" == "run" ]]; then
    tui_run_live "linux-maint run (wizard)" "${cmd[@]}"
    tui_run_next_steps "$?"
  else
    tui_run_cmd "linux-maint run --plan (wizard)" "${cmd[@]}"
  fi
}

run_menu_settings(){
  while true; do
    local choice
    local backend_cur="${LM_TUI_BACKEND:-auto}"
    local refresh_cur="${LM_TUI_DASH_REFRESH:-0}"
    local view_cur="${LM_TUI_DEFAULT_STATUS_VIEW:-table}"
    local p_cur="${LM_TUI_DEFAULT_PROBLEMS:-20}"
    local r_cur="${LM_TUI_DEFAULT_REASONS:-5}"
    local prev_cur="${LM_TUI_PREVIEW:-1}"
    local sh_cur="${LM_TUI_SHORTCUTS:-1}"
    local compact_cur="${LM_TUI_COMPACT:-0}"
    local lowc_cur="${LM_TUI_LOW_COLOR:-0}"
    local confirm_cur="${LM_TUI_CONFIRM_RISKY:-1}"
    TUI_SHORTCUT_CONTEXT="settings"
    choice="$(tui_menu_prompt_safe "Menu settings" \
      backend "Backend preference (current: $backend_cur) [b]" \
      refresh "Dashboard refresh seconds (current: $refresh_cur) [r]" \
      view "Default status view (current: $view_cur) [v]" \
      limits "Default problems/reasons (current: $p_cur/$r_cur) [l]" \
      preview "Command preview before run (current: $prev_cur) [p]" \
      shortcuts "Shortcuts r/s/t/d/c/h/x (current: $sh_cur) [k]" \
      compact "Compact menu mode (current: $compact_cur) [m]" \
      lowcolor "Low-color mode (current: $lowc_cur) [o]" \
      confirmrisk "Confirm risky actions (current: $confirm_cur) [a]" \
      save "Save settings to $(menu_settings_path) [s]" \
      reset "Reset settings to defaults [x]" \
      back "Back [q]")"
    [[ "$TUI_MENU_RC" -eq 0 && -n "${choice:-}" ]] || break
    choice="$(normalize_menu_choice "$choice")"
    choice="$(map_menu_shortcut "$choice" "settings")"
    case "$choice" in
      backend)
        local b
        b="$(tui_menu_prompt_safe "Pick backend preference" auto "Auto detect" gum "gum" dialog "dialog" whiptail "whiptail" back "Back")"
        if [[ "$TUI_MENU_RC" -eq 0 && -n "${b:-}" ]]; then
          b="$(normalize_menu_choice "$b")"
          case "$b" in
            auto) unset LM_TUI_BACKEND ;;
            gum|dialog|whiptail) export LM_TUI_BACKEND="$b" ;;
          esac
        fi
        ;;
      refresh)
        local v
        tui_input_capture "Dashboard refresh seconds (0 disables)" "${LM_TUI_DASH_REFRESH:-0}"
        v="$TUI_INPUT_VALUE"
        if [[ "$TUI_INPUT_RC" -eq 0 && "$v" =~ ^[0-9]+$ ]]; then
          export LM_TUI_DASH_REFRESH="$v"
        fi
        ;;
      view)
        local v
        v="$(tui_menu_prompt_safe "Default status view" table "Table" compact "Compact" back "Back")"
        if [[ "$TUI_MENU_RC" -eq 0 && -n "${v:-}" ]]; then
          v="$(normalize_menu_choice "$v")"
          [[ "$v" != "back" ]] && export LM_TUI_DEFAULT_STATUS_VIEW="$v"
        fi
        ;;
      limits)
        local p r
        tui_input_capture "Default problems count" "${LM_TUI_DEFAULT_PROBLEMS:-20}"
        p="$TUI_INPUT_VALUE"
        if [[ "$TUI_INPUT_RC" -eq 0 && "$p" =~ ^[0-9]+$ ]]; then export LM_TUI_DEFAULT_PROBLEMS="$p"; fi
        tui_input_capture "Default reasons count" "${LM_TUI_DEFAULT_REASONS:-5}"
        r="$TUI_INPUT_VALUE"
        if [[ "$TUI_INPUT_RC" -eq 0 && "$r" =~ ^[0-9]+$ ]]; then export LM_TUI_DEFAULT_REASONS="$r"; fi
        ;;
      preview)
        local v
        v="$(tui_menu_prompt_safe "Command preview" 1 "Enabled" 0 "Disabled" back "Back")"
        if [[ "$TUI_MENU_RC" -eq 0 && -n "${v:-}" ]]; then
          v="$(normalize_menu_choice "$v")"
          [[ "$v" != "back" ]] && export LM_TUI_PREVIEW="$v"
        fi
        ;;
      shortcuts)
        local v
        v="$(tui_menu_prompt_safe "Keyboard shortcuts" 1 "Enabled (menu keys)" 0 "Disabled" back "Back")"
        if [[ "$TUI_MENU_RC" -eq 0 && -n "${v:-}" ]]; then
          v="$(normalize_menu_choice "$v")"
          [[ "$v" != "back" ]] && export LM_TUI_SHORTCUTS="$v"
        fi
        ;;
      compact)
        local v
        v="$(tui_menu_prompt_safe "Compact menu mode" 1 "Enabled" 0 "Disabled" back "Back")"
        if [[ "$TUI_MENU_RC" -eq 0 && -n "${v:-}" ]]; then
          v="$(normalize_menu_choice "$v")"
          [[ "$v" != "back" ]] && export LM_TUI_COMPACT="$v"
        fi
        ;;
      lowcolor)
        local v
        v="$(tui_menu_prompt_safe "Low-color mode" 1 "Enabled" 0 "Disabled" back "Back")"
        if [[ "$TUI_MENU_RC" -eq 0 && -n "${v:-}" ]]; then
          v="$(normalize_menu_choice "$v")"
          [[ "$v" != "back" ]] && export LM_TUI_LOW_COLOR="$v"
        fi
        ;;
      confirmrisk)
        local v
        v="$(tui_menu_prompt_safe "Confirm risky actions" 1 "Enabled" 0 "Disabled" back "Back")"
        if [[ "$TUI_MENU_RC" -eq 0 && -n "${v:-}" ]]; then
          v="$(normalize_menu_choice "$v")"
          [[ "$v" != "back" ]] && export LM_TUI_CONFIRM_RISKY="$v"
        fi
        ;;
      save)
        if save_menu_settings; then
          tui_msgbox "Saved menu settings to $(menu_settings_path)"
        else
          tui_msgbox "Failed to save menu settings to $(menu_settings_path)"
        fi
        ;;
      reset)
        if tui_yesno "Reset all menu settings to defaults?"; then
          menu_settings_reset_defaults
          normalize_menu_settings
          tui_msgbox "Menu settings reset to defaults."
        fi
        ;;
      back) break ;;
    esac
    if [[ "${TUI_RETURN_TO_MAIN:-0}" == "1" ]]; then
      break
    fi
  done
}

run_menu_run(){
  while true; do
    local choice
    TUI_SHORTCUT_CONTEXT="run"
    choice="$(tui_menu_prompt_safe "Run checks" \
      run "Execute: run checks now (live output) [r] [changes]" \
      plan "Preview: resolved run plan only [p]" \
      wizard "Guide: guided run setup wizard [w]" \
      back "Back to main menu [b]")"
    local rc=$TUI_MENU_RC
    if [[ $rc -ne 0 || -z "${choice:-}" ]]; then
      break
    fi
    choice="$(normalize_menu_choice "$choice")"
    choice="$(map_menu_shortcut "$choice" "run")"
    case "$choice" in
      run)
        local run_rc=0
        tui_run_live "linux-maint run" "$0" run
        run_rc=$?
        if [[ "$run_rc" -ne 130 ]]; then
          tui_run_next_steps "$run_rc"
        fi
        ;;
      plan)
        tui_run_cmd "linux-maint run --plan" "$0" run --plan
        ;;
      wizard)
        tui_run_wizard
        ;;
      back)
        break
        ;;
    esac
    if [[ "${TUI_RETURN_TO_MAIN:-0}" == "1" ]]; then
      break
    fi
  done
}

