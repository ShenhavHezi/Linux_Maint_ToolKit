    help:o) printf 'explain_monitor' ;;
    help:s) printf 'explain_status' ;;
    help:b) printf 'back' ;;
    config:c) printf 'config' ;;
    config:m) printf 'monitors' ;;
    config:s) printf 'settings' ;;
    config:b) printf 'back' ;;
    settings:b) printf 'backend' ;;
    settings:r) printf 'refresh' ;;
    settings:v) printf 'view' ;;
    settings:l) printf 'limits' ;;
    settings:p) printf 'preview' ;;
    settings:k) printf 'shortcuts' ;;
    settings:m) printf 'compact' ;;
    settings:o) printf 'lowcolor' ;;
