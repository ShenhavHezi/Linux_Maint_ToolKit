    quickref) printf 'docs help reference quick reference bootstrap guide' ;;
    overview|dashboard) printf 'overview dashboard home landing status current state' ;;
    problems) printf 'problems alerts failures issues urgent bad hosts' ;;
    status|status_detail) printf 'status snapshot table current fleet' ;;
    report) printf 'report summary brief handoff ticket' ;;
    trend) printf 'trend history change compare drift last runs' ;;
    runtimes) printf 'runtime slow monitors performance latency' ;;
    run) printf 'run execute checks live start now' ;;
    plan|wizard) printf 'plan preview safe dry run scope target' ;;
    investigate|drilldown|diff|history|logs|reasons) printf 'investigate debug drilldown logs diff history reasons root cause' ;;
    repair|doctor|selfcheck|check|secprofile|focused_run) printf 'repair recover doctor validate fix readiness security focused rerun' ;;
