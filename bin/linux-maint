    done
    [[ "$NP_CONNECT_TIMEOUT" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "ERROR: LM_NOTIFY_CONNECT_TIMEOUT must be numeric" >&2; exit 2; }
    [[ "$NP_MAX_TIME" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "ERROR: LM_NOTIFY_MAX_TIME must be numeric" >&2; exit 2; }
    case "$NP_PROVIDER" in
      webhook|slack|teams|email|pagerduty) ;;
