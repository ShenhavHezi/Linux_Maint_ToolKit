)"
  gum style --border none --foreground "#60a5fa" \
    --padding "0 0" --margin "1 1" --align center \
    "$logo" >&2
}

tui_gum_hint(){
  local msg="${1:-Use arrows + Enter. Esc to go back.}"
  gum style --foreground "#94a3b8" --margin "0 2" "$msg" >&2
}

tui_gum_header(){
  local title="${1:-Linux Maint ToolKit}"
  local subtitle="${2:-Menu}"
  gum style --border rounded --border-foreground "#1d4ed8" --foreground "#e2e8f0" \
    --padding "0 2" --margin "1 1" --align left --width 110 \
    "$(gum style --bold --foreground "#e2e8f0" "$title")" \
    "$(gum style --foreground "#93c5fd" "$subtitle")" >&2
}

tui_effective_cfg_dir(){
  if [[ "$MODE" == "repo" ]]; then
    printf '%s' "${LM_CFG_DIR:-$REPO_ROOT/.etc_linux_maint}"
  else
    printf '%s' "${LM_CFG_DIR:-/etc/linux_maint}"
  fi
}

tui_effective_log_dir(){
  if [[ "$MODE" == "repo" ]]; then
    printf '%s' "${LOG_DIR:-$REPO_LOG_DIR}"
  else
    printf '%s' "${LOG_DIR:-/var/log/health}"
  fi
}

tui_effective_state_dir(){
  if [[ "$MODE" == "repo" ]]; then
    printf '%s' "${LM_STATE_DIR:-$REPO_LOG_DIR}"
  else
    printf '%s' "${LM_STATE_DIR:-/var/lib/linux_maint}"
  fi
}

tui_format_age_seconds(){
  local age="${1:-}"
  if [[ -z "$age" || "$age" == "-1" ]]; then
    printf 'missing'
    return 0
  fi
  if (( age < 60 )); then
    printf '%ss' "$age"
  elif (( age < 3600 )); then
    printf '%sm' $(( age / 60 ))
  elif (( age < 86400 )); then
    printf '%sh' $(( age / 3600 ))
  else
    printf '%sd' $(( age / 86400 ))
  fi
}

tui_context_snapshot(){
  local status_json="${1:-}"
  if [[ -z "$status_json" ]]; then
    status_json="$(tui_status_snapshot_json)"
  fi
  local log_file cfg_dir log_dir state_dir
  log_file="$(tui_latest_log_path)"
  cfg_dir="$(tui_effective_cfg_dir)"
  log_dir="$(tui_effective_log_dir)"
  state_dir="$(tui_effective_state_dir)"
  STATUS_JSON="$status_json" MODE_LOCAL="$MODE" LOG_FILE="$log_file" CFG_DIR_LOCAL="$cfg_dir" LOG_DIR_LOCAL="$log_dir" STATE_DIR_LOCAL="$state_dir" \
    SHORTCUTS_LOCAL="${LM_TUI_SHORTCUTS:-1}" PREVIEW_LOCAL="${LM_TUI_PREVIEW:-1}" python3 - <<'PY'
import json
import os
import time

raw = os.environ.get("STATUS_JSON", "")
overall = "UNKNOWN"
totals = {"OK": 0, "WARN": 0, "CRIT": 0, "UNKNOWN": 0, "SKIP": 0}
try:
    data = json.loads(raw) if raw else {}
except Exception:
    data = {}
totals_in = data.get("totals") or {}
if not totals_in and (data.get("rows") or []):
    for row in data.get("rows") or []:
        st = str((row or {}).get("status") or "")
        if st in totals:
            totals[st] += 1
for key in totals:
    if totals_in:
        try:
            totals[key] = int(totals_in.get(key, 0) or 0)
        except Exception:
            totals[key] = 0
overall = str(
    (data.get("last_status") or {}).get("overall")
    or (data.get("meta") or {}).get("overall")
    or overall
)
if not overall or overall == "UNKNOWN":
    if totals["CRIT"] > 0:
        overall = "CRIT"
    elif totals["WARN"] > 0:
        overall = "WARN"
    elif totals["UNKNOWN"] > 0:
        overall = "UNKNOWN"
    elif totals["OK"] > 0:
        overall = "OK"
    else:
        overall = "UNKNOWN"

log_file = os.environ.get("LOG_FILE", "")
age_sec = -1
if log_file:
    try:
        age_sec = max(0, int(time.time() - os.path.getmtime(log_file)))
    except Exception:
        age_sec = -1

print(f"mode={os.environ.get('MODE_LOCAL', '')}")
print(f"cfg_dir={os.environ.get('CFG_DIR_LOCAL', '')}")
print(f"log_dir={os.environ.get('LOG_DIR_LOCAL', '')}")
print(f"state_dir={os.environ.get('STATE_DIR_LOCAL', '')}")
print(f"overall={overall}")
print(f"ok={totals['OK']}")
print(f"warn={totals['WARN']}")
print(f"crit={totals['CRIT']}")
print(f"unknown={totals['UNKNOWN']}")
print(f"skip={totals['SKIP']}")
print(f"last_age={age_sec}")
print(f"shortcuts={os.environ.get('SHORTCUTS_LOCAL', '1')}")
print(f"preview={os.environ.get('PREVIEW_LOCAL', '1')}")
PY
}

tui_gum_card(){
  local title="$1" color="$2" body="$3" width="${4:-110}"
  tui_gum_card_render "$title" "$color" "$body" "$width" >&2
}

tui_gum_card_render(){
  local title="$1" color="$2" body="$3" width="${4:-110}"
  local title_line content
  title_line="$(gum style --bold --foreground "$color" "$title")"
  content="$(printf '%s\n%s' "$title_line" "$body")"
  gum style --border rounded --border-foreground "$color" --padding "1 2" --margin "0 1" \
    --foreground "#e5e7eb" --width "$width" "$content"
}

tui_render_columns(){
  local left="${1:-}" right="${2:-}" gutter="${3:-  }"
  LEFT_BLOCK="$left" RIGHT_BLOCK="$right" GUTTER_BLOCK="$gutter" python3 - <<'PY'
import os
import re

ansi_re = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")

def visible_len(s):
    return len(ansi_re.sub("", s))

left = os.environ.get("LEFT_BLOCK", "").splitlines()
right = os.environ.get("RIGHT_BLOCK", "").splitlines()
gutter = os.environ.get("GUTTER_BLOCK", "  ")
left_width = 0
for line in left:
    left_width = max(left_width, visible_len(line))

rows = max(len(left), len(right))
for idx in range(rows):
    l = left[idx] if idx < len(left) else ""
    r = right[idx] if idx < len(right) else ""
    pad = max(0, left_width - visible_len(l))
    print(f"{l}{' ' * pad}{gutter}{r}".rstrip())
PY
}

tui_gum_context_panel(){
  local status_json="${1:-}" width="${2:-110}"
  tui_gum_context_panel_render "$status_json" "$width" >&2
}

tui_gum_context_panel_render(){
  local status_json="${1:-}" width="${2:-110}"
  local snapshot mode cfg_dir log_dir state_dir overall ok warn crit unk skip age shortcuts preview
  snapshot="$(tui_context_snapshot "$status_json")"
  while IFS='=' read -r k v; do
    case "$k" in
      mode) mode="$v" ;;
      cfg_dir) cfg_dir="$v" ;;
      log_dir) log_dir="$v" ;;
      state_dir) state_dir="$v" ;;
      overall) overall="$v" ;;
      ok) ok="$v" ;;
      warn) warn="$v" ;;
      crit) crit="$v" ;;
      unknown) unk="$v" ;;
      skip) skip="$v" ;;
      last_age) age="$v" ;;
      shortcuts) shortcuts="$v" ;;
      preview) preview="$v" ;;
    esac
  done <<< "$snapshot"

  local shortcuts_label="off" preview_label="off"
  tui_bool_enabled "${shortcuts:-0}" && shortcuts_label="on"
  tui_bool_enabled "${preview:-0}" && preview_label="on"

  local overall_color="#93c5fd"
  case "${overall:-UNKNOWN}" in
    CRIT) overall_color="#ef4444" ;;
    WARN) overall_color="#f59e0b" ;;
    OK) overall_color="#22c55e" ;;
  esac

  local line1 line2
  line1="mode=${mode:-unknown}  overall=$(gum style --bold --foreground "$overall_color" "${overall:-UNKNOWN}")  last_run=$(tui_format_age_seconds "${age:--1}")  shortcuts=$shortcuts_label  preview=$preview_label"
  line2="cfg=${cfg_dir:-?}  log=${log_dir:-?}  state=${state_dir:-?}"
  tui_gum_card_render "Active context" "#334155" "$(printf '%s\n%s' "$line1" "$line2")" "$width"
}

resolve_menu_shortcut_tag(){
  local key="$1"
  shift || true
  key="${key,,}"
  [[ -n "$key" ]] || return 1
  local match="" tag first
  for tag in "$@"; do
    first="${tag:0:1}"
    first="${first,,}"
    if [[ "$first" == "$key" ]]; then
      if [[ -n "$match" ]]; then
        return 1
      fi
      match="$tag"
    fi
  done
  [[ -n "$match" ]] || return 1
  printf '%s' "$match"
}

tui_gum_read_visible_menu_choice(){
  local context="$1"
  shift || true
  local -a tags=("$@")
  [[ -t 0 ]] || return 1
  local key next third choice idx
  IFS= read -rsn1 key < /dev/tty || return 130
  case "$key" in
    $'\n'|'')
      return 2
      ;;
    $'\e')
      IFS= read -rsn1 -t 0.03 next < /dev/tty || return 130
      if [[ "$next" == "[" ]]; then
        IFS= read -rsn1 -t 0.03 third < /dev/tty || return 2
        case "$third" in
          A|B|C|D) return 2 ;;
          *) return 130 ;;
        esac
      fi
      return 130
      ;;
    [1-9])
      idx=$((10#$key - 1))
      if (( idx >= 0 && idx < ${#tags[@]} )); then
        printf '%s' "${tags[$idx]}"
        return 0
      fi
      return 1
      ;;
    '?')
      printf '__help__'
      return 0
      ;;
    '/')
      printf '__search__'
      return 0
      ;;
    *)
      if [[ "${LM_TUI_SHORTCUTS:-1}" =~ ^(1|true|TRUE|yes|YES|on|ON)$ ]]; then
        local mapped
        mapped="$(map_menu_shortcut "$key" "$context")"
        if [[ "$mapped" != "$key" ]]; then
          local t
          for t in "${tags[@]}"; do
            if [[ "$t" == "$mapped" ]]; then
              printf '%s' "$mapped"
              return 0
            fi
          done
        fi
        choice="$(resolve_menu_shortcut_tag "$key" "${tags[@]}" || true)"
        if [[ -n "$choice" ]]; then
          printf '%s' "$choice"
          return 0
        fi
      fi
      return 1
      ;;
  esac
}

tui_latest_log_path(){
  local log_dir
  log_dir="$(tui_effective_log_dir)"
  echo "$log_dir/full_health_monitor_latest.log"
}

tui_latest_summary_json_path(){
  local log_dir
  log_dir="$(tui_effective_log_dir)"
  echo "$log_dir/full_health_monitor_summary_latest.json"
}

tui_status_snapshot_json(){
  local summary_json
  summary_json="$(tui_latest_summary_json_path)"
  if [[ -f "$summary_json" ]]; then
    cat "$summary_json" 2>/dev/null || true
  fi
}

tui_gum_status_overview(){
  local status_json="${1:-}" width="${2:-110}"
  tui_gum_status_overview_render "$status_json" "$width" >&2
}

tui_gum_status_overview_render(){
  local status_json="${1:-}" width="${2:-110}" overall ok warn crit unk skip summary_file
  [[ -n "$status_json" ]] || status_json="$(tui_status_snapshot_json)"
  overall="UNKNOWN"
  ok=0; warn=0; crit=0; unk=0; skip=0; summary_file=""
  if [[ -n "$status_json" ]]; then
    while IFS='=' read -r k v; do
      case "$k" in
        overall) overall="$v" ;;
        ok) ok="$v" ;;
        warn) warn="$v" ;;
        crit) crit="$v" ;;
        unknown) unk="$v" ;;
        skip) skip="$v" ;;
        summary) summary_file="$v" ;;
      esac
    done < <(STATUS_JSON="$status_json" python3 - <<'PY'
import json
import os
import sys

raw = os.environ.get("STATUS_JSON", "")
if not raw:
    sys.exit(0)
try:
    data = json.loads(raw)
except Exception:
    sys.exit(0)
totals = data.get("totals", {}) or {}
if not totals and (data.get("rows") or []):
    totals = {"OK": 0, "WARN": 0, "CRIT": 0, "UNKNOWN": 0, "SKIP": 0}
    for row in data.get("rows") or []:
        st = str((row or {}).get("status") or "")
        if st in totals:
            totals[st] += 1
def g(k):
    try:
        return int(totals.get(k, 0) or 0)
    except Exception:
        return 0

ok = g("OK")
warn = g("WARN")
crit = g("CRIT")
unk = g("UNKNOWN")
skip = g("SKIP")

if crit > 0:
    overall = "CRIT"
elif warn > 0:
    overall = "WARN"
elif unk > 0:
    overall = "UNKNOWN"
elif ok > 0:
    overall = "OK"
else:
    overall = "UNKNOWN"

summary = data.get("summary_file") or data.get("meta", {}).get("summary_file") or ""

print(f"overall={overall}")
print(f"ok={ok}")
print(f"warn={warn}")
print(f"crit={crit}")
print(f"unknown={unk}")
print(f"skip={skip}")
print(f"summary={summary}")
PY
    )
  fi

  local color="#60a5fa"
  case "$overall" in
    CRIT) color="#ef4444" ;;
    WARN) color="#f59e0b" ;;
    OK) color="#22c55e" ;;
    UNKNOWN) color="#93c5fd" ;;
  esac

  local log_file log_lines
  log_file="$(tui_latest_log_path)"
  if [[ -f "$log_file" ]]; then
    log_lines="$(tail -n 3 "$log_file" 2>/dev/null | sed 's/^/  /')"
  else
    log_lines="  (no log yet: $log_file)"
  fi

  local overall_line totals_line body sym
  sym="$(severity_symbol "$overall")"
  overall_line="$(gum style --bold --foreground "$color" "Overall: $sym $overall")"
  totals_line="$(gum style --foreground "#e5e7eb" "OK:$ok  WARN:$warn  CRIT:$crit  UNKNOWN:$unk  SKIP:$skip")"
  body="$(gum join --vertical "$overall_line" "$totals_line")"

  tui_gum_card_render "Fleet status" "$color" "$body" "$width"
}

tui_top_reason_lines(){
  local status_json="$1" limit="${2:-3}"
  STATUS_JSON="$status_json" LIMIT_LOCAL="$limit" python3 - <<'PY'
import json
import os
from collections import Counter
raw = os.environ.get("STATUS_JSON", "")
limit = int(os.environ.get("LIMIT_LOCAL", "3") or 3)
try:
    data = json.loads(raw) if raw else {}
except Exception:
    data = {}
rows = data.get("reason_rollup") or []
printed = 0
if rows:
    for row in rows[:limit]:
        reason = str((row or {}).get("reason") or "-").replace("\n", " ")
        count = str((row or {}).get("count") or "0")
        print(f"- {reason} ({count})")
        printed += 1
else:
    counter = Counter()
    for row in data.get("rows") or []:
        status = str((row or {}).get("status") or "")
        reason = str((row or {}).get("reason") or "").strip()
        if status not in ("OK", "SKIP") and reason:
            counter[reason] += 1
    for reason, count in counter.most_common(limit):
        print(f"- {reason} ({count})")
        printed += 1
if printed == 0:
    print("- no non-OK reasons yet")
PY
}

tui_problem_lines(){
  local status_json="$1" limit="${2:-4}"
  STATUS_JSON="$status_json" LIMIT_LOCAL="$limit" python3 - <<'PY'
import json
import os
raw = os.environ.get("STATUS_JSON", "")
limit = int(os.environ.get("LIMIT_LOCAL", "4") or 4)
try:
    data = json.loads(raw) if raw else {}
except Exception:
    data = {}
rows = data.get("problems") or []
if not rows:
    rows = [r for r in (data.get("rows") or []) if str((r or {}).get("status") or "") in ("WARN", "CRIT", "UNKNOWN")]
printed = 0
for row in rows[:limit]:
    status = str((row or {}).get("status") or "?")
    monitor = str((row or {}).get("monitor") or "-")
    host = str((row or {}).get("host") or "-")
    reason = str((row or {}).get("reason") or "-").replace("\n", " ")
    print(f"- {status} {monitor} host={host} reason={reason}")
    printed += 1
if printed == 0:
    print("- no current problems")
PY
}

tui_runtime_lines(){
  local runtimes_json="${1:-}" limit="${2:-3}"
  local log_file
  log_file="$(tui_latest_log_path)"
  if [[ -f "$log_file" ]]; then
    awk -v limit="$limit" '
      /Top runtimes \(ms\)/ {capture=1; next}
      capture && /^\[/ {
        line=$0
        sub(/^\[[^]]+\][[:space:]]+/, "", line)
        if (line ~ /^[A-Za-z0-9_]+ ms=[0-9]+$/) {
          split(line, parts, / ms=/)
          printf("- %s (%s ms)\n", parts[1], parts[2])
          count++
          if (count >= limit) exit
          next
        }
        if (count > 0) exit
      }
      END {
        if (count == 0) print "- no runtime data yet"
      }
    ' "$log_file"
  else
    echo "- no runtime data yet"
  fi
}

tui_incident_recommendation_key(){
  local reason="${1:-}" monitor="${2:-}"
  case "$reason" in
    ssh_unreachable|dns_*|ping_*|tcp_*|http_*|network_*) printf 'connectivity' ;;
    config_missing|source_failed|invalid_types|baseline_missing|summary_write_failed|summary_checksum_failed|permission_denied) printf 'config' ;;
    service_failed|failed_units|service_inactive) printf 'service' ;;
    security_updates_pending|updates_pending) printf 'patching' ;;
    runtime_exceeded|timeout) printf 'runtime' ;;
    *)
      case "$monitor" in
        network*|cert*|ntp_*) printf 'connectivity' ;;
        service*) printf 'service' ;;
        config_*|ports_baseline*|user_monitor|backup_check) printf 'config' ;;
        patch*) printf 'patching' ;;
        *) printf 'general' ;;
      esac
      ;;
  esac
}

tui_next_moves_lines(){
  local overall="${1:-UNKNOWN}" reason="${2:-}" monitor="${3:-}"
  local key
  key="$(tui_incident_recommendation_key "$reason" "$monitor")"
  case "$key" in
    connectivity)
      printf '%s\n' \
        "- Open Repair for guided connectivity triage" \
        "- Open Investigate to inspect diff/logs around the failing host" \
        "- Re-run focused network checks after access is restored"
      ;;
    config)
      printf '%s\n' \
        "- Open Repair for config/init and doctor checks" \
        "- Open Docs for config and monitor requirements" \
        "- Re-run check before a full fleet run"
      ;;
    service)
      printf '%s\n' \
        "- Open Repair for service-oriented incident steps" \
        "- Open Investigate to inspect status drilldown and logs" \
        "- Re-run focused service checks after remediation"
      ;;
    patching)
      printf '%s\n' \
        "- Open Investigate to confirm the affected hosts and reasons" \
        "- Apply your update workflow outside the menu" \
        "- Re-run status or report after patching"
      ;;
    runtime)
      printf '%s\n' \
        "- Open Export to inspect recent runtimes" \
        "- Open Repair to run doctor and readiness checks" \
        "- Tune thresholds or timeouts before the next run"
      ;;
    *)
      if [[ "$overall" == "CRIT" || "$overall" == "WARN" ]]; then
        printf '%s\n' \
          "- Open Repair for doctor and guided incident response" \
          "- Open Investigate for drilldown, diff, and logs" \
          "- Create a bundle if you need to escalate"
      else
        printf '%s\n' \
          "- Review trend and runtimes in Export" \
          "- Open Docs for monitor and reason references" \
          "- Use Run to plan or execute the next check"
      fi
      ;;
  esac
}

tui_status_focus_snapshot(){
  local status_json="${1:-}"
  STATUS_JSON="$status_json" python3 - <<'PY'
import json
import os

raw = os.environ.get("STATUS_JSON", "")
overall = "UNKNOWN"
top_reason = "-"
top_monitor = "-"
top_host = "-"
try:
    data = json.loads(raw) if raw else {}
except Exception:
    data = {}
overall = str(
    (data.get("last_status") or {}).get("overall")
    or (data.get("meta") or {}).get("overall")
    or "UNKNOWN"
)
rows = data.get("reason_rollup") or []
if rows:
    top_reason = str((rows[0] or {}).get("reason") or "-")
else:
    for row in data.get("rows") or []:
        status = str((row or {}).get("status") or "")
        reason = str((row or {}).get("reason") or "")
        if status in ("WARN", "CRIT", "UNKNOWN") and reason:
            top_reason = reason
            break
problems = data.get("problems") or []
if problems:
    top_monitor = str((problems[0] or {}).get("monitor") or "-")
    top_host = str((problems[0] or {}).get("host") or "-")
else:
    for row in data.get("rows") or []:
        status = str((row or {}).get("status") or "")
        if status in ("WARN", "CRIT", "UNKNOWN"):
            top_monitor = str((row or {}).get("monitor") or "-")
            top_host = str((row or {}).get("host") or "-")
            break
print(f"overall={overall}")
print(f"top_reason={top_reason}")
print(f"top_monitor={top_monitor}")
print(f"top_host={top_host}")
PY
}

tui_section_recommended_action(){
  local context="${1:-main}" status_json="${2:-}"
  local focus overall top_reason top_monitor
  focus="$(tui_status_focus_snapshot "$status_json")"
  overall="$(printf '%s\n' "$focus" | awk -F= '/^overall=/{print $2; exit}')"
  top_reason="$(printf '%s\n' "$focus" | awk -F= '/^top_reason=/{print $2; exit}')"
  top_monitor="$(printf '%s\n' "$focus" | awk -F= '/^top_monitor=/{print $2; exit}')"
  case "$context" in
    overview)
      if [[ "$overall" == "CRIT" || "$overall" == "WARN" || "$overall" == "UNKNOWN" ]]; then
        printf 'problems'
      else
        printf 'dashboard'
      fi
      ;;
    run) printf 'plan' ;;
    investigate)
      if [[ -n "$top_reason" && "$top_reason" != "-" ]]; then
        printf 'drilldown'
      else
        printf 'history'
      fi
      ;;
    repair)
      if [[ "$overall" == "CRIT" || "$overall" == "WARN" || "$overall" == "UNKNOWN" ]]; then
        printf 'incident'
      else
        printf 'check'
      fi
      ;;
    export)
      if [[ "$overall" == "CRIT" || "$overall" == "WARN" || "$overall" == "UNKNOWN" ]]; then
        printf 'report'
      else
        printf 'export_json'
      fi
      ;;
    docs) printf 'quickref' ;;
    *) printf 'overview' ;;
  esac
}

tui_section_preview_body(){
  local context="${1:-main}" status_json="${2:-}"
  local focus overall top_reason top_monitor top_host next_action
  focus="$(tui_status_focus_snapshot "$status_json")"
  overall="$(printf '%s\n' "$focus" | awk -F= '/^overall=/{print $2; exit}')"
  top_reason="$(printf '%s\n' "$focus" | awk -F= '/^top_reason=/{print $2; exit}')"
  top_monitor="$(printf '%s\n' "$focus" | awk -F= '/^top_monitor=/{print $2; exit}')"
  top_host="$(printf '%s\n' "$focus" | awk -F= '/^top_host=/{print $2; exit}')"
  next_action="$(tui_section_recommended_action "$context" "$status_json")"
  case "$context" in
    overview)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "- Dashboard for the live operations view" \
        "- Problems for the latest non-OK rows" \
        "- Report when you need a short operator summary"
      ;;
    run)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "- Plan first when config or scope changed" \
        "- Wizard for group/host targeting and safe previews" \
        "- Run now when you already know the exact scope"
      ;;
    investigate)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "Top reason: ${top_reason:--}" \
        "Top problem: ${top_monitor:--} host=${top_host:--}" \
        "- Follow with logs or diff once you narrow the slice"
      ;;
    repair)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "Current triage: $(tui_incident_recommendation_summary "$top_reason" "$top_monitor" "$top_host")" \
        "- Doctor validates deeper dependencies and fixes" \
        "- Check confirms readiness before the next full run"
      ;;
    export)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "- Report for people, export JSON for systems" \
        "- Metrics and runtimes for dashboards and tuning" \
        "- Pack logs when you need a support bundle"
      ;;
    docs)
      printf '%s\n' \
        "Recommended first action: $next_action" \
        "- Quick reference for the common operator path" \
        "- Troubleshooting for reason tokens and failures" \
        "- Config shows the active sources and values"
      ;;
    *)
      printf '%s\n' \
        "Recommended first action: overview" \
        "- Start with the landing dashboard"
      ;;
  esac
}

tui_gum_section_focus_card(){
  local context="${1:-main}" status_json="${2:-}" width="${3:-52}"
  local color="#22c55e"
  case "$context" in
    investigate) color="#60a5fa" ;;
    repair) color="#ef4444" ;;
    export) color="#c084fc" ;;
    docs) color="#f59e0b" ;;
    run) color="#22c55e" ;;
  esac
  tui_gum_card_render "Recommended start" "$color" "$(tui_section_preview_body "$context" "$status_json")" "$width"
}

tui_gum_current_pressure_card(){
  local status_json="${1:-}" width="${2:-52}"
  local focus top_reason top_monitor top_host overall
  focus="$(tui_status_focus_snapshot "$status_json")"
  overall="$(printf '%s\n' "$focus" | awk -F= '/^overall=/{print $2; exit}')"
  top_reason="$(printf '%s\n' "$focus" | awk -F= '/^top_reason=/{print $2; exit}')"
  top_monitor="$(printf '%s\n' "$focus" | awk -F= '/^top_monitor=/{print $2; exit}')"
  top_host="$(printf '%s\n' "$focus" | awk -F= '/^top_host=/{print $2; exit}')"
  tui_gum_card_render "Current pressure" "#f59e0b" "$(printf '%s\n%s\n%s' \
    "overall=${overall:-UNKNOWN}" \
    "top_reason=${top_reason:--}" \
    "top_problem=${top_monitor:--} host=${top_host:--}")" "$width"
}

tui_menu_help_overlay_text(){
  local prompt="$1" context="$2" catalog="$3"
  local shortcuts_label="off"
  tui_bool_enabled "${LM_TUI_SHORTCUTS:-0}" && shortcuts_label="on"
  {
    printf 'Section: %s\n\n' "$prompt"
    printf 'Controls:\n'
    printf -- '- numbers 1-9 pick a visible action\n'
    printf -- '- Enter opens the full chooser\n'
    printf -- '- ? opens this help overlay\n'
    printf -- '- / opens the command palette\n'
    printf -- '- Esc goes back\n'
    printf -- '- shortcuts are %s\n' "$shortcuts_label"
    printf '\nActions:\n'
    while IFS='|' read -r tag desc; do
      [[ -n "${tag:-}" ]] || continue
      printf -- '- %s: %s\n' "$tag" "$desc"
    done <<< "$catalog"
  }
}

tui_gum_filter_menu_choice(){
  local prompt="$1" catalog="$2"
  local -a items=()
  local tag desc pick rc
  while IFS='|' read -r tag desc; do
    [[ -n "${tag:-}" ]] || continue
    items+=("${tag} - ${desc}")
  done <<< "$catalog"
  [[ "${#items[@]}" -gt 0 ]] || return 1
  set +e
  pick="$(gum filter --placeholder "$prompt: search actions" "${items[@]}")"
  rc=$?
  set -e
  [[ "$rc" -eq 0 && -n "${pick:-}" ]] || return 1
  printf '%s' "${pick%% - *}"
}

tui_gum_render_menu_items(){
  local catalog="$1" max_tag="${2:-0}"
  local tag desc padded_tag color colored_tag line
  while IFS='|' read -r tag desc; do
    [[ -n "${tag:-}" ]] || continue
    padded_tag="$(printf '%-*s' "$max_tag" "$tag")"
    color="$(tui_tag_color "$tag")"
    colored_tag="$(gum style --bold --foreground "$color" "$padded_tag")"
    line="${colored_tag}  ${desc}"
    printf '  %s\n' "$line" >&2
  done <<< "$catalog"
}

tui_gum_render_menu_frame(){
  local prompt="$1" context="$2" catalog="$3" max_tag="$4"
  local status_json left_col right_col
  status_json="$(tui_status_snapshot_json)"
  if [[ "$prompt" == "Choose your next step" ]]; then
    if [[ "${TUI_MENU_STYLE:-full}" == "full" ]]; then
      tui_gum_banner
      tui_gum_header "Linux Maint ToolKit" "Operations console"
      tui_gum_main_landing
    else
      tui_gum_header "Linux Maint ToolKit" "Operations console"
      tui_gum_main_landing_compact
    fi
  else
    tui_gum_header "Linux Maint ToolKit" "$prompt"
    if [[ "${TUI_MENU_STYLE:-full}" == "full" ]]; then
      left_col="$(printf '%s\n\n%s' \
        "$(tui_gum_context_panel_render "$status_json" 52)" \
        "$(tui_gum_section_focus_card "$context" "$status_json" 52)")"
      right_col="$(printf '%s\n\n%s' \
        "$(tui_gum_status_overview_render "$status_json" 52)" \
        "$(tui_gum_current_pressure_card "$status_json" 52)")"
      tui_render_columns "$left_col" "$right_col" "  " >&2
      printf '\n' >&2
    else
      tui_gum_context_panel "$status_json"
      printf '  recommended=%s\n' "$(tui_section_recommended_action "$context" "$status_json")" >&2
      printf '  focus=%s\n\n' "$(tui_section_preview_body "$context" "$status_json" | head -n 2 | tail -n 1)" >&2
    fi
  fi
  tui_gum_render_menu_items "$catalog" "$max_tag"
  printf '\n' >&2
  tui_gum_hint "Type shortcut or number. ? help, / search, Enter browse, Esc back."
}

tui_gum_main_landing(){
  local status_json snapshot overall top_reason top_monitor
  status_json="$(tui_status_snapshot_json)"
  snapshot="$(tui_status_focus_snapshot "$status_json")"
  overall="$(printf '%s\n' "$snapshot" | awk -F= '/^overall=/{print $2; exit}')"
  top_reason="$(printf '%s\n' "$snapshot" | awk -F= '/^top_reason=/{print $2; exit}')"
  top_monitor="$(printf '%s\n' "$snapshot" | awk -F= '/^top_monitor=/{print $2; exit}')"
  local left_col right_col
  left_col="$(printf '%s\n\n%s\n\n%s' \
    "$(tui_gum_context_panel_render "$status_json" 52)" \
    "$(tui_gum_status_overview_render "$status_json" 52)" \
    "$(tui_gum_card_render "Next moves" "#22c55e" "$(tui_next_moves_lines "${overall:-UNKNOWN}" "$top_reason" "$top_monitor")" 52)")"
  right_col="$(printf '%s\n\n%s\n\n%s' \
    "$(tui_gum_card_render "Recent problems" "#f59e0b" "$(tui_problem_lines "$status_json" 4)" 52)" \
    "$(tui_gum_card_render "Top reasons" "#60a5fa" "$(tui_top_reason_lines "$status_json" 3)" 52)" \
    "$(tui_gum_card_render "Slow monitors" "#c084fc" "$(tui_runtime_lines "" 3)" 52)")"
  tui_render_columns "$left_col" "$right_col" "  " >&2
  printf '\n' >&2
}

tui_gum_main_landing_compact(){
  local status_json snapshot overall cfg_dir log_dir age top_reason top_monitor
  status_json="$(tui_status_snapshot_json)"
  snapshot="$(tui_context_snapshot "$status_json")"
  overall="$(printf '%s\n' "$snapshot" | awk -F= '/^overall=/{print $2; exit}')"
  cfg_dir="$(printf '%s\n' "$snapshot" | awk -F= '/^cfg_dir=/{print $2; exit}')"
  log_dir="$(printf '%s\n' "$snapshot" | awk -F= '/^log_dir=/{print $2; exit}')"
  age="$(printf '%s\n' "$snapshot" | awk -F= '/^last_age=/{print $2; exit}')"
  top_reason="$(tui_top_reason_lines "$status_json" 1 | sed 's/^- //')"
  top_monitor="$(tui_problem_lines "$status_json" 1 | sed 's/^- //')"
  printf '  overview=%s  last_run=%s\n' "${overall:-UNKNOWN}" "$(tui_format_age_seconds "${age:--1}")" >&2
  printf '  cfg=%s\n' "${cfg_dir:-?}" >&2
  printf '  log=%s\n' "${log_dir:-?}" >&2
  printf '  top_reason=%s\n' "${top_reason:-none}" >&2
  printf '  top_problem=%s\n' "${top_monitor:-none}" >&2
  printf '  next=%s\n\n' "$(tui_next_moves_lines "${overall:-UNKNOWN}" "$top_reason" "" | head -n 1 | sed 's/^- //')" >&2
}

tui_menu_prompt(){
  local prompt="$1"
  shift || true
  if [[ "$TUI_BACKEND" == "gum" ]]; then
    local -a tags=()
    local -a descs=()
    local catalog=""
    local max_tag=0
    while [[ $# -gt 0 ]]; do
      local tag="$1"
      local desc="$2"
      shift 2
      tags+=("$tag")
      descs+=("$desc")
      catalog+="${tag}|${desc}"$'\n'
      local tag_len=${#tag}
      if [[ "$tag_len" -gt "$max_tag" ]]; then
        max_tag="$tag_len"
      fi
    done
    while true; do
      tui_gum_render_menu_frame "$prompt" "${TUI_SHORTCUT_CONTEXT:-main}" "$catalog" "$max_tag"
      local visible_pick="" visible_rc=0
      set +e
      visible_pick="$(tui_gum_read_visible_menu_choice "${TUI_SHORTCUT_CONTEXT:-main}" "${tags[@]}")"
      visible_rc=$?
      set -e
      if [[ "$visible_rc" -eq 0 && -n "$visible_pick" ]]; then
        case "$visible_pick" in
          __help__)
            tui_msgbox "$(tui_menu_help_overlay_text "$prompt" "${TUI_SHORTCUT_CONTEXT:-main}" "$catalog")"
            continue
            ;;
          __search__)
            local search_pick=""
            search_pick="$(tui_gum_filter_menu_choice "$prompt" "$catalog" || true)"
            if [[ -n "$search_pick" ]]; then
              printf '%s' "$search_pick"
              return 0
            fi
            continue
            ;;
          *)
            printf '%s' "$visible_pick"
            return 0
            ;;
        esac
      fi
      if [[ "$visible_rc" -eq 130 ]]; then
        return 130
      fi
      local -a items=()
      local i tag desc padded_tag color colored_tag line
      for i in "${!tags[@]}"; do
        tag="${tags[$i]}"
        desc="${descs[$i]}"
        padded_tag="$(printf '%-*s' "$max_tag" "$tag")"
        color="$(tui_tag_color "$tag")"
        colored_tag="$(gum style --bold --foreground "$color" "$padded_tag")"
        line="${colored_tag}  ${desc}"
        items+=("${line}|${tag}")
      done
      local menu_h=16
      if tui_bool_enabled "${LM_TUI_COMPACT:-0}"; then
        menu_h=12
      fi
      gum choose --header "" --height "$menu_h" --cursor "> " --label-delimiter "|" \
        --cursor-prefix "> " --selected-prefix "* " --unselected-prefix "  " \
        --show-help=false "${items[@]}"
      return $?
    done
  elif [[ "$TUI_BACKEND" == "dialog" ]]; then
    local -a menu_items=()
    local max_tag=0
    local -a tags=()
    local -a descs=()
    while [[ $# -gt 0 ]]; do
      local tag="$1"
      local desc="$2"
      shift 2
      tags+=("$tag")
      descs+=("$desc")
      local tag_len=${#tag}
      if [[ "$tag_len" -gt "$max_tag" ]]; then
        max_tag="$tag_len"
      fi
    done
    for i in "${!tags[@]}"; do
      local tag="${tags[$i]}"
      local desc="${descs[$i]}"
      local padded_tag
      padded_tag="$(printf '%-*s' "$max_tag" "$tag")"
      menu_items+=("$padded_tag" "$desc")
    done
    dialog --clear --backtitle "$TUI_BACKTITLE" --title "$TUI_TITLE" \
      --menu "$prompt" 20 78 12 "${menu_items[@]}" 3>&1 1>&2 2>&3
  else
    whiptail --title "$TUI_TITLE" --menu "$prompt" 20 78 12 "$@" 3>&1 1>&2 2>&3
  fi
}

tui_menu_prompt_safe(){
  local prompt="$1"
  shift || true
  local out rc
  TUI_MENU_RC=0
  set +e
  out="$(tui_menu_prompt "$prompt" "$@")"
  rc=$?
  set -e
  TUI_MENU_RC="$rc"
  printf '%s' "$out"
  return 0
}

tui_tag_color(){
  if tui_bool_enabled "${LM_TUI_LOW_COLOR:-0}"; then
    echo "#94a3b8"
    return 0
  fi
  case "$1" in
    overview|overview_screen|dashboard|problems|reports|status|summary|runindex) echo "#38bdf8" ;;
    run) echo "#22c55e" ;;
    investigate|drilldown|diff|history|logs|reasons|status_detail|tools) echo "#f59e0b" ;;
    repair|incident|recommended|doctor|selfcheck|check|secprofile|focused_run|diagnostics|logslive) echo "#fb7185" ;;
    export|report|trend|runtimes|metrics_prom|metrics_json|pack_logs|export_json) echo "#c084fc" ;;
    docs|quickref|faq|troubleshooting|about|config|monitors|settings|explain_reason|explain_monitor|explain_status|help|monitors_matrix) echo "#22c55e" ;;
    wizard) echo "#22c55e" ;;
    exit|back) echo "#64748b" ;;
    *) echo "#94a3b8" ;;
  esac
}

strip_ansi(){
  python3 - <<'PY'
import re, sys
s = sys.stdin.read()
print(re.sub(r'\x1b\[[0-9;]*[A-Za-z]', '', s), end='')
PY
}

normalize_menu_choice(){
  python3 - "$1" <<'PY'
import re
import sys

s = sys.argv[1]
s = re.sub(r'\x1b\[[0-9;]*[A-Za-z]', '', s)
m = re.search(r'[A-Za-z0-9_-]+', s)
if m:
    print(m.group(0), end="")
PY
}

map_menu_shortcut(){
  local choice="$1"
  local context="${2:-main}"
  case "${LM_TUI_SHORTCUTS:-1}" in
    1|true|TRUE|yes|YES|on|ON) ;;
    *) printf '%s' "$choice"; return 0 ;;
  esac
  case "${context}:${choice}" in
    main:o) printf 'overview' ;;
    main:r) printf 'run' ;;
    main:i) printf 'investigate' ;;
    main:p) printf 'repair' ;;
    main:e) printf 'export' ;;
    main:h) printf 'docs' ;;
    main:s) printf 'overview' ;;
    main:t) printf 'investigate' ;;
    main:d) printf 'repair' ;;
    main:c) printf 'docs' ;;
    main:x) printf 'exit' ;;
    overview:d) printf 'dashboard' ;;
    overview:s) printf 'status' ;;
    overview:p) printf 'problems' ;;
