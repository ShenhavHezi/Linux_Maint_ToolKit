PY
      exit 0
    fi

    HISTORY_NOTE=""
    if [[ ! -f "$index_file" ]]; then
      for alt in /var/tmp/run_index.jsonl /var/tmp/linux_maint/run_index.jsonl /tmp/linux_maint/run_index.jsonl; do
