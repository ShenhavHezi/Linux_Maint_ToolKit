import json, os, re, shlex, subprocess, sys

cfg_dir = os.environ.get("CFG_DIR", "/etc/linux_maint")
show_sources = os.environ.get("CFG_SOURCES", "0") == "1"
json_mode = os.environ.get("CFG_JSON", "0") == "1"
