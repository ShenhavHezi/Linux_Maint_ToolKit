    echo "=== linux-maint runtimes ==="
    echo "files=${#rt_files[@]}"
    echo "log_dir=$log_dir"
    awk '
      /RUNTIME monitor=/ {
        for (i=1; i<=NF; i++) {
          if ($i ~ /^monitor=/) { split($i,a,"="); mon=a[2]; }
          if ($i ~ /^ms=/) { split($i,b,"="); ms=b[2]; }
