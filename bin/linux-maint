tui_menu_action_previews_text(){
  local prompt="$1" context="$2" catalog="$3"
  local tag desc
  printf 'Action previews for %s\n' "$prompt"
  while IFS='|' read -r tag desc; do
    [[ -n "${tag:-}" ]] || continue
    printf '\n[%s] %s\n' "$tag" "$desc"
    printf '%s\n' "$(tui_menu_action_preview_body "$context" "$tag" "$desc")"
  done <<< "$catalog"
}

tui_menu_recommended_action_preview_card(){
  local context="$1" catalog="$2" width="${3:-52}" status_json="${4:-}"
  local recommended desc line tag
  recommended="$(tui_section_recommended_action "$context" "$status_json")"
  desc=""
  while IFS='|' read -r tag line; do
    [[ "$tag" == "$recommended" ]] || continue
    desc="$line"
    break
  done <<< "$catalog"
  if [[ -z "$desc" ]]; then
    recommended="$(printf '%s\n' "$catalog" | awk -F'|' 'NF>=2 {print $1; exit}')"
    desc="$(printf '%s\n' "$catalog" | awk -F'|' 'NF>=2 {print $2; exit}')"
  fi
  tui_gum_card_render "Action preview" "#334155" "$(tui_menu_action_preview_body "$context" "$recommended" "$desc")" "$width"
}

tui_palette_rank(){
  local tag="$1" context="${2:-main}" status_json="${3:-}" boot_snapshot="${4:-}"
  local score=50 recommended overall summary_ready log_ready history_ready config_dir_exists inventory_ready
  recommended="$(tui_section_recommended_action "$context" "$status_json")"
  [[ -n "$boot_snapshot" ]] || boot_snapshot="$(tui_bootstrap_state_snapshot)"
  config_dir_exists="$(tui_snapshot_value "$boot_snapshot" config_dir_exists)"
  inventory_ready="$(tui_snapshot_value "$boot_snapshot" inventory_ready)"
  summary_ready="$(tui_snapshot_value "$boot_snapshot" summary_ready)"
  log_ready="$(tui_snapshot_value "$boot_snapshot" log_ready)"
  history_ready="$(tui_snapshot_value "$boot_snapshot" history_ready)"
  overall="$(tui_snapshot_value "$(tui_context_snapshot "$status_json")" overall)"
  [[ "$tag" == "$recommended" ]] && score=$((score + 35))
  case "$context:$tag" in
    main:quickstart|quickstart:first_setup|overview:dashboard|run:plan|investigate:drilldown|repair:incident|export:report|docs:quickref|main:triage|main:share|triage:incident|share:report|share:quickref)
      score=$((score + 18))
      ;;
    run:wizard|repair:doctor|export:pack_logs|investigate:logs|docs:troubleshooting|triage:doctor|triage:drilldown|triage:logs|share:pack_logs|share:troubleshooting)
      score=$((score + 12))
      ;;
  esac
  if [[ "$config_dir_exists" != "1" || "$inventory_ready" != "1" || "$summary_ready" != "1" ]]; then
    case "$tag" in
      quickstart|first_setup|plan|wizard|check|config|quickref)
        score=$((score + 25))
        ;;
      trend|history|runtimes|metrics_prom|metrics_json|export_json|report|share)
        score=$((score - 12))
        ;;
    esac
  fi
  if [[ "$history_ready" == "1" ]]; then
    case "$tag" in
      history|trend|runtimes) score=$((score + 8)) ;;
    esac
  fi
  if [[ "$log_ready" == "1" ]]; then
    case "$tag" in
      logs|pack_logs) score=$((score + 8)) ;;
    esac
  fi
  case "$overall" in
    CRIT|WARN|UNKNOWN)
      case "$tag" in
        problems|report|incident|doctor|logs|pack_logs|status|drilldown|triage|share)
          score=$((score + 10))
          ;;
      esac
      ;;
  esac
  case "$tag" in
    back|exit|about) score=$((score - 25)) ;;
    settings) score=$((score - 12)) ;;
  esac
  printf '%s' "$score"
}

tui_gum_filter_menu_choice(){
  local prompt="$1" catalog="$2" context="${3:-main}"
  local -a items=()
  local tag desc aliases pick rc score display recommended status_json boot_snapshot badge
  status_json="$(tui_status_snapshot_json)"
  boot_snapshot="$(tui_bootstrap_state_snapshot)"
  recommended="$(tui_section_recommended_action "$context" "$status_json")"
  while IFS='|' read -r tag desc; do
    [[ -n "${tag:-}" ]] || continue
    aliases="$(tui_palette_aliases "$tag" "$context")"
    score="$(tui_palette_rank "$tag" "$context" "$status_json" "$boot_snapshot")"
    badge=""
    [[ "$tag" == "$recommended" ]] && badge="recommended"
    display="${tag} :: $(tui_menu_display_desc "$desc")"
    [[ -n "$badge" ]] && display="${display} :: ${badge}"
    [[ -n "$aliases" ]] && display="${display} :: aliases=${aliases}"
    items+=("$(printf '%05d|%s' "$score" "$display")")
  done <<< "$catalog"
  [[ "${#items[@]}" -gt 0 ]] || return 1
  mapfile -t items < <(printf '%s\n' "${items[@]}" | sort -t'|' -k1,1nr | cut -d'|' -f2-)
  set +e
  pick="$(gum filter --placeholder "$prompt: search commands, aliases, or tasks" "${items[@]}")"
  rc=$?
  set -e
  [[ "$rc" -eq 0 && -n "${pick:-}" ]] || return 1
  printf '%s' "${pick%% :: *}"
}

tui_menu_display_desc(){
  local desc="${1:-}"
  printf '%s' "$desc" | sed -E 's/( \[[^][]+\])+$//'
}

tui_gum_render_menu_frame(){
  local prompt="$1" context="$2" catalog="$3"
  local status_json left_col right_col
  status_json="$(tui_status_snapshot_json)"
  if [[ "$prompt" == "Choose your next step" ]]; then
    if [[ "${TUI_MENU_STYLE:-full}" == "full" ]]; then
      tui_gum_banner
      tui_gum_header "Linux Maint ToolKit" "Operations console"
      tui_gum_main_landing
    else
      tui_gum_header "Linux Maint ToolKit" "Operations console"
      tui_gum_main_landing_compact
    fi
  else
    tui_gum_header "Linux Maint ToolKit" "$prompt"
    if [[ "${TUI_MENU_STYLE:-full}" == "full" ]]; then
      left_col="$(printf '%s\n\n%s' \
        "$(tui_gum_context_panel_render "$status_json" 52)" \
        "$(tui_gum_section_focus_card "$context" "$status_json" 52)")"
      right_col="$(printf '%s\n\n%s' \
        "$(tui_gum_status_overview_render "$status_json" 52)" \
        "$(tui_menu_recommended_action_preview_card "$context" "$catalog" 52 "$status_json")")"
      tui_render_columns "$left_col" "$right_col" "  " >&2
      printf '\n' >&2
    else
      tui_gum_context_panel "$status_json"
      printf '  recommended=%s\n' "$(tui_section_recommended_action "$context" "$status_json")" >&2
      printf '  focus=%s\n' "$(tui_section_preview_body "$context" "$status_json" | head -n 2 | tail -n 1)" >&2
      printf '  preview=%s\n\n' "$(tui_section_recommended_action "$context" "$status_json")" >&2
    fi
  fi
  printf '\n' >&2
  tui_gum_hint "Use arrows + Enter. Search, previews, and quick help are available in the chooser. Esc back."
}

tui_gum_main_landing(){
  local status_json snapshot overall top_reason top_monitor
  status_json="$(tui_status_snapshot_json)"
  if ! tui_has_summary_snapshot; then
    local boot_snapshot left_col right_col
    boot_snapshot="$(tui_bootstrap_state_snapshot)"
    left_col="$(printf '%s\n\n%s\n\n%s' \
      "$(tui_gum_context_panel_render "$status_json" 52)" \
      "$(tui_gum_card_render "Start here" "#14b8a6" "$(tui_bootstrap_next_steps_lines "$boot_snapshot")" 52)" \
      "$(tui_gum_card_render "What's missing" "#f59e0b" "$(tui_bootstrap_missing_lines "$boot_snapshot")" 52)")"
    right_col="$(printf '%s\n\n%s\n\n%s' \
      "$(tui_gum_card_render "Optional inputs" "#60a5fa" "$(tui_optional_skip_lines "$(tui_snapshot_value "$boot_snapshot" cfg_dir)" 5)" 52)" \
      "$(tui_gum_card_render "Why the dashboard is empty" "#c084fc" "$(tui_section_empty_state_body overview "$boot_snapshot" | awk 'NR>1 {print}')" 52)" \
      "$(tui_gum_card_render "Recommended flow" "#22c55e" "$(printf '%s\n%s\n%s' \
        "- Quickstart -> first setup" \
        "- Repair -> check when config is ready" \
        "- Run -> plan before the first live execution")" 52)")"
    tui_render_columns "$left_col" "$right_col" "  " >&2
    printf '\n' >&2
    return 0
  fi
  snapshot="$(tui_status_focus_snapshot "$status_json")"
  overall="$(printf '%s\n' "$snapshot" | awk -F= '/^overall=/{print $2; exit}')"
  top_reason="$(printf '%s\n' "$snapshot" | awk -F= '/^top_reason=/{print $2; exit}')"
  top_monitor="$(printf '%s\n' "$snapshot" | awk -F= '/^top_monitor=/{print $2; exit}')"
  local left_col right_col
  left_col="$(printf '%s\n\n%s\n\n%s' \
    "$(tui_gum_context_panel_render "$status_json" 52)" \
    "$(tui_gum_status_overview_render "$status_json" 52)" \
    "$(tui_gum_card_render "Next moves" "#22c55e" "$(tui_next_moves_lines "${overall:-UNKNOWN}" "$top_reason" "$top_monitor")" 52)")"
  right_col="$(printf '%s\n\n%s\n\n%s' \
    "$(tui_gum_card_render "Recent problems" "#f59e0b" "$(tui_problem_lines "$status_json" 4)" 52)" \
    "$(tui_gum_card_render "Top reasons" "#60a5fa" "$(tui_top_reason_lines "$status_json" 3)" 52)" \
    "$(tui_gum_card_render "Slow monitors" "#c084fc" "$(tui_runtime_lines "" 3)" 52)")"
  tui_render_columns "$left_col" "$right_col" "  " >&2
  printf '\n' >&2
}

tui_gum_main_landing_compact(){
  local status_json snapshot overall cfg_dir log_dir age top_reason top_monitor
  status_json="$(tui_status_snapshot_json)"
  if ! tui_has_summary_snapshot; then
    local boot_snapshot
    boot_snapshot="$(tui_bootstrap_state_snapshot)"
    printf '  overview=NOT_STARTED  last_run=missing\n' >&2
    printf '  cfg=%s\n' "$(tui_snapshot_value "$boot_snapshot" cfg_dir)" >&2
    printf '  inventory=%s\n' "$( [[ "$(tui_snapshot_value "$boot_snapshot" inventory_ready)" == "1" ]] && printf ready || printf missing )" >&2
    printf '  summary=no  history=%s  logs=%s\n' \
      "$( [[ "$(tui_snapshot_value "$boot_snapshot" history_ready)" == "1" ]] && printf yes || printf no )" \
      "$( [[ "$(tui_snapshot_value "$boot_snapshot" log_ready)" == "1" ]] && printf yes || printf no )" >&2
    printf '  next=%s\n\n' "$(tui_bootstrap_next_steps_lines "$boot_snapshot" | head -n 1 | sed 's/^- //')" >&2
    return 0
  fi
  snapshot="$(tui_context_snapshot "$status_json")"
  overall="$(printf '%s\n' "$snapshot" | awk -F= '/^overall=/{print $2; exit}')"
  cfg_dir="$(printf '%s\n' "$snapshot" | awk -F= '/^cfg_dir=/{print $2; exit}')"
  log_dir="$(printf '%s\n' "$snapshot" | awk -F= '/^log_dir=/{print $2; exit}')"
  age="$(printf '%s\n' "$snapshot" | awk -F= '/^last_age=/{print $2; exit}')"
  top_reason="$(tui_top_reason_lines "$status_json" 1 | sed 's/^- //')"
  top_monitor="$(tui_problem_lines "$status_json" 1 | sed 's/^- //')"
  printf '  overview=%s  last_run=%s\n' "${overall:-UNKNOWN}" "$(tui_format_age_seconds "${age:--1}")" >&2
  printf '  cfg=%s\n' "${cfg_dir:-?}" >&2
  printf '  log=%s\n' "${log_dir:-?}" >&2
  printf '  top_reason=%s\n' "${top_reason:-none}" >&2
  printf '  top_problem=%s\n' "${top_monitor:-none}" >&2
  printf '  next=%s\n\n' "$(tui_next_moves_lines "${overall:-UNKNOWN}" "$top_reason" "" | head -n 1 | sed 's/^- //')" >&2
}

tui_command_preview_reads(){
  local sub="${1:-}" cmd_text="${2:-}"
  case "$sub" in
    run)
      printf '%s\n' \
        "- config from $(tui_effective_cfg_dir)" \
        "- inventory from $(tui_effective_serverlist_path) and $(tui_effective_hosts_dir)" \
        "- monitor scripts and current policy settings"
      ;;
    check)
      printf '%s\n' \
        "- config from $(tui_effective_cfg_dir)" \
        "- preflight and validation monitors" \
        "- current repo/install readiness paths"
      ;;
    doctor)
      printf '%s\n' \
        "- config from $(tui_effective_cfg_dir)" \
        "- writable path, dependency, and service readiness" \
        "- current repo/install mode and permissions"
      ;;
    report|status|summary|trend|runtimes|metrics|export|history|diff|logs)
      printf '%s\n' \
        "- latest artifacts under $(tui_effective_log_dir)" \
        "- history state under $(tui_effective_state_dir) when needed" \
        "- current config root for hints and metadata"
      ;;
    config)
      printf '%s\n' \
        "- config from $(tui_effective_cfg_dir)" \
        "- merged config sources and defaults" \
        "- lint/type validation when requested"
      ;;
    init)
      printf '%s\n' \
        "- starter templates from the repo/install template directory" \
        "- current target config root $(tui_effective_cfg_dir)"
      ;;
    baseline)
      printf '%s\n' \
        "- current local system state for the selected baseline" \
        "- baseline files under $(tui_effective_cfg_dir)/baselines"
      ;;
    pack-logs)
      printf '%s\n' \
        "- logs from $(tui_effective_log_dir)" \
        "- state files from $(tui_effective_state_dir)" \
        "- config metadata from $(tui_effective_cfg_dir)"
      ;;
    *)
      printf '%s\n' \
        "- current config, state, and log roots for this mode" \
        "- command-specific inputs implied by $cmd_text"
      ;;
  esac
}

tui_command_preview_writes(){
  local sub="${1:-}" cmd_text="${2:-}"
  case "$sub" in
    run)
      if [[ "$cmd_text" == *"--plan"* || "$cmd_text" == *"--dry-run"* ]]; then
        printf '%s\n' "- no host changes; plan output only"
      else
        printf '%s\n' \
          "- run artifacts under $(tui_effective_log_dir)" \
          "- history/index state under $(tui_effective_state_dir)" \
          "- optional audit records when enabled"
      fi
      ;;
    check|status|report|summary|trend|runtimes|metrics|export|history|diff|logs|config)
      printf '%s\n' "- read-only output to the terminal unless --output is used"
      ;;
    doctor)
      if [[ "$cmd_text" == *"--fix"* || "$cmd_text" == *"--fix-deps"* ]]; then
        printf '%s\n' \
          "- may repair directories, permissions, or dependencies" \
          "- writes doctor artifacts and any fix actions taken"
      else
        printf '%s\n' "- read-only diagnostics and doctor artifacts only"
      fi
      ;;
    init)
      printf '%s\n' \
        "- starter config files under $(tui_effective_cfg_dir)" \
        "- may overwrite existing templates only when --force is set"
      ;;
    baseline)
      if [[ "$cmd_text" == *"--update"* ]]; then
        printf '%s\n' "- baseline files under $(tui_effective_cfg_dir)/baselines"
      else
        printf '%s\n' "- read-only preview/diff output unless --update is used"
      fi
      ;;
    pack-logs)
      printf '%s\n' "- support bundle artifacts in the selected output directory"
      ;;
    *)
      printf '%s\n' "- command-specific output only"
      ;;
  esac
}

tui_command_next_hint(){
  local sub="${1:-}" cmd_text="${2:-}"
  case "$sub" in
    run)
      if [[ "$cmd_text" == *"--plan"* || "$cmd_text" == *"--dry-run"* ]]; then
        printf '%s' "Review scope and expected skips, then execute the live run if it looks correct."
      else
        printf '%s' "Use Overview or Export next to review the result and capture any follow-up artifacts."
      fi
      ;;
    check) printf '%s' "If readiness is clean, go to Run -> plan or execute the intended scope." ;;
    doctor) printf '%s' "Re-run check or a focused status/report after doctor to confirm the outcome." ;;
    report|status|summary) printf '%s' "If you see failures, move to Investigate or Repair for drilldown and remediation." ;;
    export|pack-logs) printf '%s' "Share the generated artifact or return to Investigate if you still need more context." ;;
    init) printf '%s' "Edit inventory, then run check and run --plan before the first live execution." ;;
    baseline) printf '%s' "After baseline capture, return to Run or Investigate for cleaner drift comparisons." ;;
    config) printf '%s' "After reviewing config, run check to validate it against the current environment." ;;
    *) printf '%s' "Return to the menu flow that matches the result: Overview, Investigate, Repair, or Export." ;;
  esac
}

tui_command_preview_body(){
  local title="$1"
  shift || true
  local cmd_text="$*" sub="${2:-}"
  local risk reads writes next_hint
  risk="$(tui_command_risk_badge "$(tui_command_risk_level "${1:-}" "$sub" "$cmd_text")")"
  reads="$(tui_command_preview_reads "$sub" "$cmd_text")"
  writes="$(tui_command_preview_writes "$sub" "$cmd_text")"
  next_hint="$(tui_command_next_hint "$sub" "$cmd_text")"
  printf '%s\n' \
    "Command preview: $title" \
    "" \
    "Command:" \
    "  $cmd_text" \
    "" \
    "Risk:" \
    "  $risk" \
    "" \
    "Reads:" \
    "$reads" \
    "" \
    "Writes:" \
    "$writes" \
    "" \
    "Likely next step:" \
    "  $next_hint"
}

tui_menu_prompt(){
  local prompt="$1"
  shift || true
  if [[ "$TUI_BACKEND" == "gum" ]]; then
    local -a tags=()
    local -a descs=()
    local catalog=""
    local max_tag=0
    while [[ $# -gt 0 ]]; do
      local tag="$1"
      local desc="$2"
      shift 2
      tags+=("$tag")
      descs+=("$desc")
      catalog+="${tag}|${desc}"$'\n'
      local tag_len=${#tag}
      if [[ "$tag_len" -gt "$max_tag" ]]; then
        max_tag="$tag_len"
      fi
    done
    while true; do
      tui_gum_render_menu_frame "$prompt" "${TUI_SHORTCUT_CONTEXT:-main}" "$catalog" "$max_tag"
      local -a items=()
      local i tag desc padded_tag color colored_tag line
      local menu_h=16
      if tui_bool_enabled "${LM_TUI_COMPACT:-0}"; then
        menu_h=12
      fi
      for i in "${!tags[@]}"; do
        tag="${tags[$i]}"
        desc="${descs[$i]}"
        padded_tag="$(printf '%-*s' "$max_tag" "$tag")"
        color="$(tui_tag_color "$tag")"
        colored_tag="$(gum style --bold --foreground "$color" "$padded_tag")"
        line="${colored_tag}  $(tui_menu_display_desc "$desc")"
        items+=("${line}|${tag}")
      done
      items+=("$(printf '%-*s  %s|%s' "$max_tag" "search" "Search commands, aliases, and task words" "__search__")")
      items+=("$(printf '%-*s  %s|%s' "$max_tag" "preview" "Preview actions in this menu" "__preview__")")
      items+=("$(printf '%-*s  %s|%s' "$max_tag" "help" "Show quick controls for this menu" "__help__")")
      local pick="" pick_rc=0
      set +e
      pick="$(gum choose --header "" --height "$menu_h" --cursor "> " --label-delimiter "|" \
        --cursor-prefix "> " --selected-prefix "* " --unselected-prefix "  " \
        --show-help=false "${items[@]}")"
      pick_rc=$?
      set -e
      if [[ "$pick_rc" -ne 0 || -z "${pick:-}" ]]; then
        return "$pick_rc"
      fi
      case "$pick" in
        __help__)
          tui_msgbox "$(tui_menu_help_overlay_text "$prompt" "${TUI_SHORTCUT_CONTEXT:-main}" "$catalog")"
          continue
          ;;
        __preview__)
          tui_textbox_text "Action previews" "$(tui_menu_action_previews_text "$prompt" "${TUI_SHORTCUT_CONTEXT:-main}" "$catalog")"
          continue
          ;;
        __search__)
          local search_pick=""
          search_pick="$(tui_gum_filter_menu_choice "$prompt" "$catalog" "${TUI_SHORTCUT_CONTEXT:-main}" || true)"
          if [[ -n "$search_pick" ]]; then
            printf '%s' "$search_pick"
            return 0
          fi
          continue
          ;;
        *)
          printf '%s' "$pick"
          return 0
          ;;
      esac
    done
  elif [[ "$TUI_BACKEND" == "dialog" ]]; then
    local -a menu_items=()
    local max_tag=0
    local -a tags=()
    local -a descs=()
    local prompt_body menu_rows menu_height
    while [[ $# -gt 0 ]]; do
      local tag="$1"
      local desc="$2"
      shift 2
      tags+=("$tag")
      descs+=("$desc")
      local tag_len=${#tag}
      if [[ "$tag_len" -gt "$max_tag" ]]; then
        max_tag="$tag_len"
      fi
    done
    for i in "${!tags[@]}"; do
      local tag="${tags[$i]}"
      local desc="${descs[$i]}"
      local padded_tag
      padded_tag="$(printf '%-*s' "$max_tag" "$tag")"
      menu_items+=("$padded_tag" "$(tui_menu_display_desc "$desc")")
    done
    prompt_body="$(tui_fallback_menu_prompt_body "$prompt" "${TUI_SHORTCUT_CONTEXT:-main}")"
    menu_rows=${#tags[@]}
    menu_height=$((menu_rows + 11))
    [[ "$menu_height" -lt 22 ]] && menu_height=22
    [[ "$menu_height" -gt 28 ]] && menu_height=28
    dialog --clear --backtitle "$TUI_BACKTITLE" --title "$TUI_TITLE" \
      --menu "$prompt_body" "$menu_height" 96 "$menu_rows" "${menu_items[@]}" 3>&1 1>&2 2>&3
  else
    local -a menu_items=()
    local max_tag=0
    local -a tags=()
    local -a descs=()
    local prompt_body menu_rows menu_height
    while [[ $# -gt 0 ]]; do
      local tag="$1"
      local desc="$2"
      shift 2
      tags+=("$tag")
      descs+=("$desc")
      local tag_len=${#tag}
      if [[ "$tag_len" -gt "$max_tag" ]]; then
        max_tag="$tag_len"
      fi
    done
    for i in "${!tags[@]}"; do
      local tag="${tags[$i]}"
      local desc="${descs[$i]}"
      local padded_tag
      padded_tag="$(printf '%-*s' "$max_tag" "$tag")"
      menu_items+=("$padded_tag" "$(tui_menu_display_desc "$desc")")
    done
    prompt_body="$(tui_fallback_menu_prompt_body "$prompt" "${TUI_SHORTCUT_CONTEXT:-main}")"
    menu_rows=${#tags[@]}
    menu_height=$((menu_rows + 11))
    [[ "$menu_height" -lt 22 ]] && menu_height=22
    [[ "$menu_height" -gt 28 ]] && menu_height=28
    whiptail --title "$TUI_TITLE" --menu "$prompt_body" "$menu_height" 96 "$menu_rows" "${menu_items[@]}" 3>&1 1>&2 2>&3
  fi
}

tui_menu_prompt_safe(){
  local prompt="$1"
  shift || true
  local out rc
  TUI_MENU_RC=0
  set +e
  out="$(tui_menu_prompt "$prompt" "$@")"
  rc=$?
  set -e
  TUI_MENU_RC="$rc"
  printf '%s' "$out"
  return 0
}

tui_tag_color(){
  if tui_bool_enabled "${LM_TUI_LOW_COLOR:-0}"; then
    echo "#94a3b8"
    return 0
  fi
  case "$1" in
    quickstart|first_setup|current_incident|escalation|docs|quickref|faq|troubleshooting|config|monitors|explain_reason|explain_monitor|explain_status) echo "#0f766e" ;;
    overview|overview_screen|dashboard|problems|reports|status|summary|runindex|share|export|report|trend|runtimes|metrics_prom|metrics_json|pack_logs|export_json) echo "#2563eb" ;;
    run|wizard) echo "#15803d" ;;
    triage|investigate|drilldown|diff|history|logs|reasons|status_detail|tools|repair|incident|recommended|doctor|selfcheck|check|secprofile|focused_run|diagnostics|logslive) echo "#b45309" ;;
    settings|about|help|monitors_matrix) echo "#64748b" ;;
    exit|back) echo "#64748b" ;;
    *) echo "#94a3b8" ;;
  esac
}

strip_ansi(){
  python3 - <<'PY'
import re, sys
s = sys.stdin.read()
print(re.sub(r'\x1b\[[0-9;]*[A-Za-z]', '', s), end='')
PY
}

normalize_menu_choice(){
  python3 - "$1" <<'PY'
import re
import sys

s = sys.argv[1]
s = re.sub(r'\x1b\[[0-9;]*[A-Za-z]', '', s)
m = re.search(r'[A-Za-z0-9_-]+', s)
if m:
    print(m.group(0), end="")
PY
}

map_menu_shortcut(){
  local choice="$1"
  local context="${2:-main}"
  case "${LM_TUI_SHORTCUTS:-1}" in
    1|true|TRUE|yes|YES|on|ON) ;;
    *) printf '%s' "$choice"; return 0 ;;
  esac
  case "${context}:${choice}" in
    main:q) printf 'quickstart' ;;
    main:o) printf 'overview' ;;
    main:r) printf 'run' ;;
    main:t) printf 'triage' ;;
    main:s) printf 'share' ;;
    main:i) printf 'triage' ;;
    main:p) printf 'triage' ;;
    main:e) printf 'share' ;;
    main:h) printf 'share' ;;
    main:d) printf 'triage' ;;
    main:c) printf 'share' ;;
    main:x) printf 'exit' ;;
    triage:i) printf 'incident' ;;
    triage:d) printf 'drilldown' ;;
    triage:l) printf 'logs' ;;
    triage:r) printf 'reasons' ;;
    triage:x) printf 'diff' ;;
    triage:f) printf 'focused_run' ;;
    triage:c) printf 'check' ;;
    triage:o) printf 'doctor' ;;
    triage:h) printf 'history' ;;
    triage:b) printf 'back' ;;
    share:r) printf 'report' ;;
    share:e) printf 'export_json' ;;
    share:p) printf 'pack_logs' ;;
    share:t) printf 'trend' ;;
    share:u) printf 'runtimes' ;;
    share:m) printf 'metrics_prom' ;;
    share:j) printf 'metrics_json' ;;
    share:h) printf 'quickref' ;;
    share:f) printf 'faq' ;;
    share:g) printf 'troubleshooting' ;;
    share:c) printf 'config' ;;
    share:s) printf 'settings' ;;
    share:a) printf 'about' ;;
    share:b) printf 'back' ;;
    overview:d) printf 'dashboard' ;;
    overview:s) printf 'status' ;;
    overview:p) printf 'problems' ;;
    overview:r) printf 'report' ;;
    overview:t) printf 'trend' ;;
    overview:b) printf 'back' ;;
    investigate:d) printf 'drilldown' ;;
    investigate:f) printf 'diff' ;;
    investigate:h) printf 'history' ;;
    investigate:l) printf 'logs' ;;
    investigate:r) printf 'reasons' ;;
    investigate:u) printf 'runtimes' ;;
    investigate:b) printf 'back' ;;
    repair:i) printf 'incident' ;;
    repair:c) printf 'check' ;;
    repair:d) printf 'doctor' ;;
    repair:s) printf 'selfcheck' ;;
    repair:p) printf 'secprofile' ;;
    repair:f) printf 'focused_run' ;;
    repair:b) printf 'back' ;;
    export:r) printf 'report' ;;
    export:t) printf 'trend' ;;
    export:u) printf 'runtimes' ;;
    export:m) printf 'metrics_prom' ;;
    export:j) printf 'metrics_json' ;;
    export:e) printf 'export_json' ;;
    export:p) printf 'pack_logs' ;;
    export:b) printf 'back' ;;
    docs:h) printf 'quickref' ;;
    docs:t) printf 'troubleshooting' ;;
    docs:f) printf 'faq' ;;
    docs:r) printf 'reasons' ;;
    docs:m) printf 'monitors' ;;
    docs:e) printf 'explain_reason' ;;
    docs:o) printf 'explain_monitor' ;;
    docs:w) printf 'explain_status' ;;
    docs:c) printf 'config' ;;
    docs:s) printf 'settings' ;;
