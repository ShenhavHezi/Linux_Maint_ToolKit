    aggregate_check_rc() {
      local best=0 rc
      for rc in "$@"; do
        case "$rc" in
          0|1|2|3) ;;
          *) rc=3 ;;
        esac
        if [[ "$rc" -gt "$best" ]]; then
          best="$rc"
        fi
      done
      printf '%s\n' "$best"
    }

