        return 0
      fi
      local perm group world
      perm="$(stat -c %a "$path" 2>/dev/null || echo "")"
      group=$(( (perm / 10) % 10 ))
      world=$(( perm % 10 ))
      if (( (group & 2) || (world & 2) )); then
        if [[ "$DOCTOR_STRICT" -eq 1 ]]; then
          printf "%-40s %s\n" "$path" "${C_RED}CRIT (group/world writable)${C_RESET}"
